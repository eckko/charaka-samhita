  ],
  "lines_iast": [
   "varṣāśaraddhemanteṣu tu dakṣiṇābhimukjhe'rke kālamārgameghavātavarṣābhihatapratāpe śaśini cāvyāhatabale māhendrasalilapraśāntasantāpe jagati arūkṣā rasāḥ pravardhante'mlalavaṇamadhurā yathākramaṃ tatra balamupacīyate nṛṇāmiti"
  ],
