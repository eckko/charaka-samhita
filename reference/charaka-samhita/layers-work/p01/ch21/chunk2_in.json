  "lines_deva": [
   "उपवासोऽसुखा शय्या सत्त्वौदार्यं तमोजयः",
   "निद्राप्रसङ्गमहितं वारयन्ति समुत्थितम्"
  ],
  "lines_iast": [
   "upavāso'sukhā śayyā sattvaudāryaṃ tamojayaḥ",
   "nidrāprasaṅgamahitaṃ vārayanti samutthitam"
  ],
