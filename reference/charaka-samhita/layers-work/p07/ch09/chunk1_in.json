   "07.09.17b",
   "07.09.17c"
  ],
  "lines_deva": [
   "तत्र श्लोकौ---",
   "पञ्च दध्यादिभिस्त्वेका सुरा सौवीरकेण च",
   "एकोऽरिष्टस्तथा योग एकः कम्पिल्लकेन च"
  ],
  "lines_iast": [
   "tatra ślokau---",
   "pañca dadhyādibhistvekā surā sauvīrakeṇa ca",
   "eko'riṣṭastathā yoga ekaḥ kampillakena ca"
  ],
