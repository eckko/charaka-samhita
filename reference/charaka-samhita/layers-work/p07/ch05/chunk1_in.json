   "07.05.12c"
  ],
  "lines_deva": [
   "तत्र श्लोकः---",
   "कषायैर्नव चूर्णैश्च पञ्चोक्ताः सलिलैस्त्रयः",
   "एकश्च कृशरायां स्याद्योगास्तेऽष्टादश स्मृताः"
  ],
  "lines_iast": [
   "tatra ślokaḥ---",
   "kaṣāyairnava cūrṇaiśca pañcoktāḥ salilaistrayaḥ",
   "ekaśca kṛśarāyāṃ syādyogāste'ṣṭādaśa smṛtāḥ"
  ],
