 {
  "n": "14",
  "type": "verse",
  "line_ids": [
   "07.06.14a",
   "07.06.14b"
  ],
  "lines_deva": [
   "लेहेऽष्टौ सप्त मांसे च योग इक्षुरसेऽपरः",
   "कृतवेधनकल्पेऽस्मिन् षष्टिर्योगाः प्रकीर्तिताः"
  ],
  "lines_iast": [
   "lehe'ṣṭau sapta māṃse ca yoga ikṣurase'paraḥ",
   "kṛtavedhanakalpe'smin ṣaṣṭiryogāḥ prakīrtitāḥ"
  ],
