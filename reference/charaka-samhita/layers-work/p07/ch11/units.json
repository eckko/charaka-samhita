   "07.11.18b",
   "07.11.18c"
  ],
  "lines_deva": [
   "तत्र श्लोकौ---",
   "कषाया दश षट् तैलेऽष्टौ च सर्पिषि",
   "पञ्च मद्ये त्रयो लेहा योगः कम्पिल्लके तथा"
  ],
  "lines_iast": [
   "tatra ślokau---",
   "kaṣāyā daśa ṣaṭ taile'ṣṭau ca sarpiṣi",
   "pañca madye trayo lehā yogaḥ kampillake tathā"
  ],
