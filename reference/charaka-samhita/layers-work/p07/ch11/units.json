  ],
  "lines_iast": [
   "ityagniveśakṛte tantre carakapratisaṃskṛte'prāpte dṛḍhabalasaṃpūrite kalpasthāne saptalāśāṅkhinīkalpo nāmaikādaśo'dhyāyaḥ"
  ],
