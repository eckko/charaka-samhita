   "07.11.19a",
   "07.11.19b"
  ],
  "lines_deva": [
   "सप्तलाशङ्खिनीभ्यां ते त्रिंशदुक्ता नवाधिकाः",
   "योगाः सिद्धाः समस्ताभ्यामेकशोऽपि च ते हिताः"
  ],
  "lines_iast": [
   "saptalāśaṅkhinībhyāṃ te triṃśaduktā navādhikāḥ",
   "yogāḥ siddhāḥ samastābhyāmekaśo'pi ca te hitāḥ"
  ],
