  ],
  "lines_deva": [
   "कषायेष्वासुतं पूत्वा तेनैव विधिना पिबेत्",
   "अथवारग्वधादीनां सप्तानां पूर्ववत् पिबेत्"
  ],
  "lines_iast": [
   "kaṣāyeṣvāsutaṃ pūtvā tenaiva vidhinā pibet",
   "athavāragvadhādīnāṃ saptānāṃ pūrvavat pibet"
  ],
