   "07.02.5b"
  ],
  "lines_deva": [
   "यथोक्तगुणयुक्तानां देशजानां यथाविधि",
   "पयः पुष्पेऽस्य, निर्वृत्ते फले पेया पयस्कृता"
  ],
  "lines_iast": [
   "yathoktaguṇayuktānāṃ deśajānāṃ yathāvidhi",
   "payaḥ puṣpe'sya, nirvṛtte phale peyā payaskṛtā"
  ],
