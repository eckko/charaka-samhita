   "07.02.14c"
  ],
  "lines_deva": [
   "तत्र श्लोकौ---",
   "षट् क्षीरे मदिरामण्डे एको द्वादश चापरे",
   "सप्त चारग्वधादीनां कषायेऽष्टौ च वर्तिषु"
  ],
  "lines_iast": [
   "tatra ślokau---",
   "ṣaṭ kṣīre madirāmaṇḍe eko dvādaśa cāpare",
   "sapta cāragvadhādīnāṃ kaṣāye'ṣṭau ca vartiṣu"
  ],
