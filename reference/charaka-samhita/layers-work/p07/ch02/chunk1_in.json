  "lines_deva": [
   "आसुत्य च सुरामण्डे मृदित्वा प्रस्रुतं पिबेत्",
   "कफजेऽरोचके कासे पाण्डुरोगे सयक्ष्मणि"
  ],
  "lines_iast": [
   "āsutya ca surāmaṇḍe mṛditvā prasrutaṃ pibet",
   "kaphaje'rocake kāse pāṇḍuroge sayakṣmaṇi"
  ],
