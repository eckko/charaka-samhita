  "lines_deva": [
   "जीवकर्षभकेक्षूणां शतावर्या रसेन वा",
   "पित्तश्लेष्मज्वरे दद्याद्वातपित्तज्वरेऽथवा"
  ],
  "lines_iast": [
   "jīvakarṣabhakekṣūṇāṃ śatāvaryā rasena vā",
   "pittaśleṣmajvare dadyādvātapittajvare'thavā"
  ],
