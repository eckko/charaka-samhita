  "lines_deva": [
   "दन्तीक्वाथेऽञ्जलिं मज्ज्ञः शम्पाकस्य गुडस्य च",
   "दत्त्वा मासार्धमासस्थमरिष्टं पापयेत च"
  ],
  "lines_iast": [
   "dantīkvāthe'ñjaliṃ majjñaḥ śampākasya guḍasya ca",
   "dattvā māsārdhamāsasthamariṣṭaṃ pāpayeta ca"
  ],
