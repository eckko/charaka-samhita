  "lines_deva": [
   "आरग्वधो राजवृक्षः शम्पाकश्चतुरङ्गुलः",
   "प्रग्रहः कृतमालश्च कर्णिकारोऽवघातकः"
  ],
  "lines_iast": [
   "āragvadho rājavṛkṣaḥ śampākaścaturaṅgulaḥ",
   "pragrahaḥ kṛtamālaśca karṇikāro'vaghātakaḥ"
  ],
