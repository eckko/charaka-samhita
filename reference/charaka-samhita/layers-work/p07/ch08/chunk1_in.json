  "lines_deva": [
   "चतुरङ्गुलमज्ज्ञस्तु प्रसृतं वाथवाञ्जलिम्",
   "सुरामण्डेन संयुक्तमथवा कोलसीधुना"
  ],
  "lines_iast": [
   "caturaṅgulamajjñastu prasṛtaṃ vāthavāñjalim",
   "surāmaṇḍena saṃyuktamathavā kolasīdhunā"
  ],
