  "line_ids": [
   "07.08.18a",
   "07.08.18b"
  ],
  "lines_deva": [
   "लेहेऽरिष्टे घृते द्वे च योगा द्वादश कीर्तिताः",
   "चतुरङ्गुलकल्पेऽस्मिन् सुकुमाराः सुखोदयाः"
  ],
  "lines_iast": [
   "lehe'riṣṭe ghṛte dve ca yogā dvādaśa kīrtitāḥ",
   "caturaṅgulakalpe'smin sukumārāḥ sukhodayāḥ"
  ],
