  "lines_deva": [
   "स्निग्धोऽतिजाड्यं पवनं तु रूक्षस्तन्वल्पमात्रालवणस्त्वयोगम्",
   "करोति मात्राभ्यधिकोऽतियोगं क्षामं तु सान्द्रः सुचिरेण चैति"
  ],
  "lines_iast": [
   "snigdho'tijāḍyaṃ pavanaṃ tu rūkṣastanvalpamātrālavaṇastvayogam",
   "karoti mātrābhyadhiko'tiyogaṃ kṣāmaṃ tu sāndraḥ sucireṇa caiti"
  ],
