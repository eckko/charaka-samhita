[
 {
  "id": "06.07.171b",
  "kind": "sample",
  "line": "गोपित्तमञ्जने द्वे पिप्पल्यः काललोहरजः॥",
  "before": "लेपः किलासहन्ता बीजान्यावल्गुजानि लाक्षा च।",
  "after": "शुद्ध्या शोणितमोक्षैर्विरूक्षणैर्भक्षणैश्च सक्तूनाम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.09.8a",
  "kind": "sample",
  "line": "समुद्भ्रमं बुद्धिमनःस्मृतीनामुन्मादमागन्तुनिजोत्थमाहुः।",
  "before": "विन्दत्यपास्तस्मृतिबुद्धिसंज्ञो भ्रमत्ययं चेत इतस्ततश्च॥",
  "after": "तस्योद्भवं पञ्चविधं पृथक् तु वक्ष्यामि लिङ्गानि चिकित्सितं च॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.09.78a",
  "kind": "sample",
  "line": "घृतमांसवितृप्तं वा निवाते स्थापयेत् सुखम्।",
  "before": "जन्मादे विषमे चैव ज्वरेऽपस्मार एव च॥",
  "after": "त्यक्त्वा मतिस्मृतिभ्रंशं संज्ञां लब्ध्वा प्रमुच्यते॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.10.14b",
  "kind": "sample",
  "line": "तीक्ष्णैरादौ भिषक् कुर्यात् कर्मभिर्वमनादिभिः॥",
  "before": "तैरावृतानां हृत्स्रोतोमनसां संप्रबोधनम्।",
  "after": "वातिकं बस्तिभूयिष्ठैः पैत्तं प्रायो विरेचनैः।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.10.20b",
  "kind": "sample",
  "line": "श्रेयसीमाढकीं मूर्वां दन्तीं भूनिम्बचित्रकौ॥",
  "before": "भागीं पाठां त्रिकटुकं त्रिवृतां विचुलानि च।",
  "after": "द्वे सारिवे रोहिषं च भूतीकं मदयन्तिकाम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.11.50a",
  "kind": "sample",
  "line": "धात्रीफलविदारीक्षुजीवनीयरसैर्घृतम्।",
  "before": "समसक्तु क्षतक्षीणे रक्तगुल्मे च तद्धितम्॥",
  "after": "अजागोपयसोश्चैव सप्त प्रस्थान् पचेद्भिषक्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.11.72b",
  "kind": "sample",
  "line": "पृथग्बिभीतकानां च पिप्पल्याश्च चतुर्थिकाम्॥",
  "before": "कुडवार्धं तुगाक्षीर्याः खर्जूराणां च विंशतिम्।",
  "after": "त्रिंशत्पलानि खण्डाच्च मधुकात् कर्षमेव च।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.12.53a",
  "kind": "sample",
  "line": "पटोलमूलामरदारुदन्तीत्रायन्तिपिप्पल्यभयाविशालाः।",
  "before": "इति कंसहरीतकी।",
  "after": "यष्ट्याह्वयं तिक्तकरोहिणी च सचन्दना स्यान्निचुलानि दार्वी॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.12.92a",
  "kind": "sample",
  "line": "क्षुद्रप्रमाणाः पिडकाः शरीरे सर्वाङ्गगाः सज्वरदाहतृष्णाः।",
  "before": "यश्चापराः स्युः पिडकाः प्रकीर्णाः स्थूलाणुमध्या अपि पित्तजास्ताः॥",
  "after": "कण्डूयुताः सारुचिसप्रसेका रोमान्तिकाः पित्तकफात् प्रदिष्टाः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.13.22a",
  "kind": "sample",
  "line": "पृथग्दोषैः समस्तैश्च प्लीहबद्धक्षतोदकैः।",
  "before": "मन्दोऽग्निः श्लक्ष्णगण्डत्वं कार्श्यं चोदरलक्षणम्॥",
  "after": "संभवन्त्युदराण्यष्टौ तेषां लिङ्गां पृथक् शृणु॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.13.146b",
  "kind": "sample",
  "line": "क्रमान्निर्हृतदोषाणां जाङ्गलप्रतिभोजिनाम्।",
  "before": "गुल्मघ्नं नीलिनीसर्पिः स्नेहं वा मिश्रकं पिबेत्।",
  "after": "दोषशेषनिवृत्त्यर्थं योगान् वक्ष्याम्यतः परम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.14.26b",
  "kind": "sample",
  "line": "शोथो हृत्पार्श्वशूलं च यस्यासाध्योऽर्शसो हि सः॥",
  "before": "हस्ते पादे मुखे नाभ्यां गुदे वृषणयोस्तथा।",
  "after": "हृत्पार्श्वशूलं संमोहश्छर्दिरङ्गस्य रुग् ज्वरः।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.14.57a",
  "kind": "sample",
  "line": "आर्कं पयः सुधाकाण्डं कटुकालाबुपल्लवाः।",
  "before": "शूलश्वयथुहृद्युक्तं चुलूकीवसयाथवा॥",
  "after": "करञ्जो बस्तमूत्रं च लेपनं श्रेष्ठमर्शसाम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.14.69b",
  "kind": "sample",
  "line": "दधित्थबिल्वसंयुक्तं युक्तं वा चव्यचित्र्कैः॥",
  "before": "सुरां सहपुषापाठां दद्यात् सौवर्चलान्विताम्।",
  "after": "भल्लातकयुतं वापि प्रदद्यात्तक्रतर्पणम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.14.205b",
  "kind": "sample",
  "line": "भोजनमद्यादम्लैः शालिश्यामाककोद्रवजम्॥",
  "before": "पयसा शृतेन यूषैर्मसूरमुद्गाढकीमकुष्ठानाम्।",
  "after": "शशहरिणलावमांसैः कपिञ्जलैणेयकैः सुसिद्धैश्च।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.15.52a",
  "kind": "sample",
  "line": "अधस्तु पक्वमामं वा प्रवृत्तं ग्रहणीगदः।",
  "before": "दुर्बलो विदहत्यन्नं तद्यात्यूर्ध्वमधोऽपि वा॥",
  "after": "उच्यते सर्वमेवान्नं प्रायो ह्यस्य विदह्यते॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.15.158b",
  "kind": "sample",
  "line": "लोध्रं शाबरकं चैव मासार्धस्थं पिबेत्तु तम्॥",
  "before": "प्रियङ्गुमुस्तमञ्जिष्ठाविडङ्गमधुकप्लवान्।",
  "after": "एष मूलासवः सिद्धो दीपनो रक्तपित्तजित्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.16.1",
  "kind": "sample",
  "line": "अथा पाण्डुरोगचिकित्सितं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रेऽप्राप्ते दृढबलसंपूरिते चिकित्सास्थाने ग्रहणीचिकित्सितं नाम पञ्चदशोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.16.66b",
  "kind": "sample",
  "line": "स्वर्णक्षीरी त्रिवृच्छ्यामे भद्रदारु सनागरम्॥",
  "before": "मातुलुङ्गस्य तत् पूतं पाण्डुशोथहरं पिबेत्।",
  "after": "गोमूत्राञ्जलिना पिष्टं मूत्रे वा क्वथितं पिबेत्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.16.101a",
  "kind": "sample",
  "line": "धात्रीफलरसद्रोणे चूर्णितं लेहवत् पचेत्।",
  "before": "प्रास्थिकीं पिप्पलीं क्राक्षां शर्करार्धतुलां शुभाम्॥",
  "after": "शीतं मधुप्रस्थयुतं लिह्यात् पाणितलं ततः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.17.6b",
  "kind": "sample",
  "line": "यथा श्वासश्च हिक्का च प्राणानाशु निकृन्ततः॥",
  "before": "कामं प्राणहरा रोगा बहवो न तु ते तथा।",
  "after": "अन्यैरप्युपसृष्टस्य रोगैर्जन्तोः पृथग्विधैः।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.17.41a",
  "kind": "sample",
  "line": "न मर्मबाधाजननी नेन्द्रियाणां प्रबाधिनी।",
  "before": "तथा शनैरसंबन्धं क्षुवंश्चापि स हिक्कते॥",
  "after": "हिक्का पीते तथा भुक्ते शमं याति च सान्नजा॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.17.79b",
  "kind": "sample",
  "line": "कृत्वा धूमं पिबेच्छृङ्गं बालं वा स्नायु वा गवाम्॥",
  "before": "मधूच्छिष्टं सर्जरसं घृतं मल्लकसंपुटे।",
  "after": "स्योनाकवर्धमानानां नाडीं शुष्कां कुशस्य वा।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.17.88b",
  "kind": "sample",
  "line": "कफाधिकस्तथैनैको रूक्षो बह्वनिलोऽपरः॥",
  "before": "हिक्काश्वासामयी ह्येको बलवान् दुर्बलोऽपरः।",
  "after": "ककाधिके बलस्थे च वमनं सविरेचनम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.17.96a",
  "kind": "sample",
  "line": "रास्नां बलां पञ्चमूलं ह्रस्वं मुद्गान् सचित्रकान्।",
  "before": "सनागरः सलवणः स्याद्यूषो भोजने हितः॥",
  "after": "पक्त्वाम्भसि रसे तस्मिन् यूषः साध्यश्च पूर्ववत्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.18.162b",
  "kind": "sample",
  "line": "सिद्धं सर्पिः पिबेद्गुल्मश्वासार्तिक्षयकासनुत्॥",
  "before": "जले चतुर्गुणे पक्त्वा पादशेषेण तत्समम्।",
  "after": "इति गुडूच्यादिघृतम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.22.10b",
  "kind": "sample",
  "line": "तृष्णोद्भूता कुरुते, पञ्चविधां लिङ्गतः शृणु ताम्॥",
  "before": "जिह्वानिर्गममरुचिं बाधिर्यं मर्मदूयनं सादम्।",
  "after": "अब्धातुं देहस्थं कुपितः पवनो यदा विशोषयति।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.23.94a",
  "kind": "sample",
  "line": "अनेन सत्यवाक्येन सिध्यतामगदो ह्ययम्।",
  "before": "मातुश्च पाणिग्रहणं समुद्रस्य च शोषणम्॥",
  "after": "हिलिमिलिसंस्पृष्टे रक्ष सर्वभेषजोत्तमे स्वाहा॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.23.109b",
  "kind": "sample",
  "line": "स्फुटति च सशब्दमेकावर्तो विहतार्चिरपि च स्यात्॥",
  "before": "शिखिबर्हविचित्रार्चिस्तीक्ष्णाक्षमरूक्षकुणपधूमश्च।",
  "after": "पात्रस्थं च विवर्णं भोज्यं स्यान्मक्षिकांश्च मारयति।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.23.166b",
  "kind": "sample",
  "line": "तस्य तस्यौषधैः कुर्याद्विपरीतगुणैः क्रियाम्॥",
  "before": "यस्य यस्य हि दोषस्य लिङ्गाधिक्यानि लक्षयेत्।",
  "after": "हृत्पीडोर्ध्वानिलः स्तम्भः सिरायामोऽस्थिपर्वरुक्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.24.79a",
  "kind": "sample",
  "line": "आपाने सात्त्विकान् बुद्ध्वा तथा राजसतामसान्।",
  "before": "संमोहक्रोधनिद्रान्तमापानं तामसं स्मृतम्॥",
  "after": "जह्यात्सहायान् यैः पीत्वा मद्यदोषानुपाश्नुते॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.24.155a",
  "kind": "sample",
  "line": "संस्पर्शाश्चन्दनार्द्राणां नारीणां च समारुताः।",
  "before": "पूर्णानां हिमपूर्णानां दृतीनां पवनाहताः॥",
  "after": "चन्दनानां च मुख्यानां शस्ताः पित्तमदात्यये॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.24.171b",
  "kind": "sample",
  "line": "पटोलयूषमम्लं वा यूषमामलकस्य वा॥",
  "before": "तनुनाल्पेन लघुना कट्वम्लेनाल्पसर्पिषा।",
  "after": "प्रभूतकटुसंक्तं सयवान्नं प्रदापयेत्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.25.17a",
  "kind": "sample",
  "line": "तौ द्वौ नानात्वभेदेन निरुक्ता विंशतिर्व्रणाः।",
  "before": "कफव्रणं प्रशमयेत्तथा लङ्घनपाचनैः॥",
  "after": "तेषां परीक्षा त्रिविधा, प्रदुष्टा द्वादश स्मृताः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.26.81a",
  "kind": "sample",
  "line": "तैलं ससौवीरकमस्तुतक्रं वाते प्रपेयं लवणं सुखोष्णम्।",
  "before": "विद्यात्त्रिदोषं त्वपि सर्वलिङ्गं तीव्रार्तितोदं कृमिजं सकण्डूम्॥",
  "after": "मूत्राम्बुसिद्धं लवणैश्च तैलमानाहगुल्मार्तिहृदामयघ्नम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.26.194b",
  "kind": "sample",
  "line": "गृहधूमो यवक्षारः पाठा व्योषं रसाञ्जनम्॥",
  "before": "कण्ठरोगेषु सर्वेषु धार्याः स्युरमृतोपमाः।",
  "after": "तेजोह्वा त्रिफला लोध्रं चित्रकश्चेति चूर्णितम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.26.207a",
  "kind": "sample",
  "line": "द्रोणशेषं कषायं तं पूत्वा भूयः पचेच्छनैः।",
  "before": "प्रक्षाल्य जर्जरीकृत्य चतुर्द्रोणेऽम्भसः पचेत्॥",
  "after": "ततस्तस्मिन् घनीभूते चूर्णीकृत्याक्षभागिकम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.26.256c",
  "kind": "sample",
  "line": "वदने कृष्णसर्पस्य निहितं मासमञ्जनम्॥",
  "before": "इति दृष्टिप्रदा वर्तिः।",
  "after": "ततस्तस्मात् समृद्धृत्य सुशुष्कं चूर्णयेद्बुधः।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.26.262a",
  "kind": "sample",
  "line": "क्षौद्रयुक्ता निहन्त्यान्ध्यं पटलं च रसक्रिया।",
  "before": "धात्रीसैन्धवपिप्पल्यः स्युरल्पमरिचाः समाः॥",
  "after": "इति नेत्ररोगचिकित्सा।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.28.159b",
  "kind": "sample",
  "line": "काकोलीक्षीरकाकोलीश्रावण्यतिबलानखैः॥",
  "before": "बलातामलकीमेदाशतपुष्पर्धिजीवकैः।",
  "after": "महाश्रावणिजीवन्तीविदारीकपिकच्छुभिः।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.28.179b",
  "kind": "sample",
  "line": "अनेकशतशस्तच्च सिद्धं स्याद्वातरोगनुत्॥",
  "before": "यच्च शीतज्वरे तैलमगुर्वाद्यमुदाहृतम्।",
  "after": "वक्ष्यन्ते यानि तैलानि वातशोणितकेऽपि च।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.28.193a",
  "kind": "sample",
  "line": "शिरोगते तु सकफे धूमनस्यादि कारयेत्।",
  "before": "मधुरौषधसिद्धैश्च तैलैस्तमनुवासयेत्॥",
  "after": "हृते पित्ते कफे यः स्यादुरःस्रोतोऽनुगोऽनिलः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.29.17b",
  "kind": "sample",
  "line": "निस्तोदः स्फुरणं भेदो गुरुत्वं सुप्तिरेव च॥",
  "before": "जानुअङ्घोरुकट्यं सहस्तपादाङ्गसन्धिषु।",
  "after": "कण्डूः संधिषु रुग्भूत्वा भूत्वा नश्यति चासकृत्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.29.130a",
  "kind": "sample",
  "line": "चन्दनार्द्रस्तनकराः प्रिया नार्यः प्रियंवदाः।",
  "before": "शयने पुलिनस्पर्शशीतमारुतवीजिते॥",
  "after": "स्पर्शशीताः सुखस्पर्शा घ्नन्ति दाहं रुजं क्लमम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.30.61b",
  "kind": "sample",
  "line": "वातार्तानां च योनीनां सेकाभ्यङ्गपिचुक्रियाः॥",
  "before": "वातार्तायाः पिचुं दद्याद्योनौ च प्रणयेत्ततः।",
  "after": "(उष्णाः सिग्धाः प्रकर्तव्यास्तैलानि स्नेहनानि च।) हिंस्राकल्कं तु वातार्ता कोष्णमभ्यज्य धारयेत्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.30.88b",
  "kind": "sample",
  "line": "वराहस्य रसो मेद्यः सकौलत्थोऽनिलाधिके॥",
  "before": "क्षौद्रेण संयुतं पेयं वातसृग्दरनाशनम्।",
  "after": "शर्कराक्षौद्रयष्ट्याह्वनागरैर्वा युतं दधि।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.30.178a",
  "kind": "sample",
  "line": "रसादीनां संक्षयाच्च तथैवावृष्यसेवनात्।",
  "before": "अतिप्रवयसां शुक्रं प्रायशः क्षीयते नृणाम्॥",
  "after": "बलवीर्येन्दिर्याणां च क्रमेणैव परिक्षयात्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.30.192b",
  "kind": "sample",
  "line": "क्लैब्योपशान्तये कुर्यात् क्षीणक्षतहितं च यत्॥",
  "before": "शुक्रदोषेषु निर्दिष्टं भेषजं यन्मयानघ!।",
  "after": "बस्तयः क्षीरसर्पींषि वृष्ययोगाश्च ये मताः।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.30.220",
  "kind": "sample",
  "line": "यत्तदेव त्रिदोषस्य कारणं प्रदरस्य तु।) त्रिलिङ्गसंयुतं विद्यान्नैकावस्थमसृग्दरम्॥",
  "before": "(वक्ष्यते क्षीरदोषाणां सामान्यमिह कारणम्॥",
  "after": "नारी त्वतिपरिक्लिष्टा यदा प्रक्षीणशोणिता।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.01.54b",
  "kind": "sample",
  "line": "अत्यासनस्थानवचांसि यानं स्वप्नं दिवा मैथुनवेगरोधान्॥",
  "before": "कालस्तु बस्त्यादिषु याति यावांस्तावान् भवेद्द्विः परिहारकालः।",
  "after": "शीतोपचारातपशोकरोषांस्त्यजेदकालाहितभोजनं च।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.03.12a",
  "kind": "sample",
  "line": "ब्स्तेरलाभे प्लवजो गलो वा स्यादङ्कपादः सुघनः पटो वा।",
  "before": "नृणां वयो वीक्ष्य यथानुरूपं रेत्रेषु योज्यस्तु सुबद्धमूत्रः॥",
  "after": "आस्थापनार्हं पुरुषं विधिज्ञः समीक्ष्य पुण्येऽहनि शुक्लपक्षे॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.03.13a",
  "kind": "sample",
  "line": "प्रशस्तनक्षत्रमुहूर्तयोगे जीर्णान्नमेकाग्रमुपक्रमेत।",
  "before": "आस्थापनार्हं पुरुषं विधिज्ञः समीक्ष्य पुण्येऽहनि शुक्लपक्षे॥",
  "after": "बलां गुडूचीं त्रिफलां सरास्नां द्वे पञ्चमूले च पलोन्मितानि॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.03.19a",
  "kind": "sample",
  "line": "स्निग्धे गुदे नेत्रचतुर्थभागं स्निग्धं शनैरृज्वनु पृष्ठवंशम्।",
  "before": "सङ्कोच्य सव्येतरदस्य सक्थि वामं प्रसार्य प्रणयेत्ततस्तम्॥",
  "after": "अकम्पनावेपनलाघवादीन् पाण्योर्गुणांश्चापि विदर्शयंस्तम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.03.59a",
  "kind": "sample",
  "line": "द्विपञ्चमूले त्रिफलां सबिल्वां फालानि गोमूत्रयुत कषायः।",
  "before": "पटोलपथ्यामरदारुभिर्वा सपिप्पलीकैः क्वथितैर्जलेऽग्नौ॥",
  "after": "कलिङ्गपाठाफलमुस्तकल्कः ससैन्धवः क्षारयुतः सतैलः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.06.68a",
  "kind": "sample",
  "line": "अल्पं तु बहुदोषस्य दोषमुत्क्लिश्य भेषजम्।",
  "before": "यष्टीमधुकसिद्धं वा स्नेहास्तिं प्रदापयेत्॥",
  "after": "अल्पाल्पं स्रावयेत् कण्डूं शोफं कुष्ठानि गौरवम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.07.9a",
  "kind": "sample",
  "line": "नाभिबस्तिरुजं दाहं हृल्लेपं श्वयथुं गुदे।",
  "before": "करोति गुरुकोष्ठत्वं वातमूत्रशकृद्ग्रहम्॥",
  "after": "कण्डूगण्डानि वैवर्ण्यमरुचिं वह्निमार्दवम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.08.6a",
  "kind": "sample",
  "line": "पञ्चमूलरसात् पञ्च द्वौ तैलात् क्षौद्रसर्पिषोः।",
  "before": "बिल्वादिमूलक्वाथाद्द्वौ कौलत्थाद्द्वौ स वातनुत्॥",
  "after": "एकैकः प्रसृतो बस्तिः स्नेहनीयोऽनिलापहः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.09.21b",
  "kind": "sample",
  "line": "शोकाद्व्याध्यनुषङ्गाच्च वायुनोदीरितः कफः॥",
  "before": "मधुरस्निग्धगुर्वन्नसेवनाच्चिन्तनाच्छ्रमात्।",
  "after": "यदासौ समवस्कन्द्य हृदयं हृदयाश्रयान्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "08.12.18-15",
  "kind": "sample",
  "line": "सुरासौवीरककुलत्थमांसरसमधुघृततैलसप्तप्रसृतो मुस्तशताह्वाकल्कितः सलवणो बस्तिः सर्ववातरोगहरः",
  "before": "तद्वन्मधुघृताभ्यां मांसरसतुल्यो मुस्ताक्षयुक्तः पूर्ववद्बस्तिर्वातबलासपादहर्षगुल्मत्रिकोरुजानूरुनिकुञ्चनबस्तिवृषणमेढ्रत्रिकपृष्ठशूलहरः",
  "after": "द्विपञ्चमूलत्रिफलाबिल्वमदनफलकषायो गोमूत्रसिद्धः कुटजमदनफलमुस्तपाठाकल्कितः सैन्धवयावशूकक्षौद्रतैलयुक्तो बस्तिः श्लेष्मव्याधिबस्त्याटोपवातशुक्रसङ्गपाण्डुरोगाजीर्णविसूचिकालसकेषु देय इति॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.06.7c",
  "kind": "sample",
  "line": "तदभावे हि भावानां सर्वाभावः शरीरिणाम्॥",
  "before": "सर्वमन्यत् परित्यज्य शरीरमनुपालयेत्।",
  "after": "क्षयः शोषस्यायतनमिति यदुक्तं तदनुव्याख्यास्यामः---यदा पुरुषोऽतिमात्रं शोकचिन्तापरिगतहृदयो भवति, ईर्ष्योत्कण्ठाभयक्रोधादिभिर्वा समाविश्यते, कृशो वा सन् रूक्षान्नपानसेवी भवति, दुर्ब्लप्रकृतिरनाहारोऽल्पाहारो वा भवति, तदा तस्य हृदयस्थायी रसः क्षयमुपैति; स तस्योपक्षयाच्छोषं प्राप्नोति, अप्रतीकाराच्चानुबध्यते यक्ष्मणा यथोपदेक्ष्यमाणरूपेण;",
  "note": "ordinary line, no flag"
 }
]