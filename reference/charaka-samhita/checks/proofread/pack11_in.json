[
 {
  "id": "06.06.59a",
  "kind": "metre",
  "line": "तत्र श्लोकाः---",
  "before": "ताः शल्यविद्भिः कुशलैश्चिकित्स्याः शस्त्रेण संशोधनरोपणैश्च॥",
  "after": "हेतुर्दोषो दूष्यं मेहानां साध्यतानुरूपश्च।",
  "note": "4 aksharas"
 },
 {
  "id": "06.06.59c",
  "kind": "metre",
  "line": "मेही द्विविधस्त्रिविधं भिषग्जितमतिक्षपणदोषः॥",
  "before": "हेतुर्दोषो दूष्यं मेहानां साध्यतानुरूपश्च।",
  "after": "योगीन्द्रनाथसेनसंमतः पाठः",
  "note": "19 aksharas"
 },
 {
  "id": "06.06.60a",
  "kind": "metre",
  "line": "आद्या यवान्नविकृतिर्मन्था मेहापहाः कषायाश्च।",
  "before": "योगीन्द्रनाथसेनसंमतः पाठः",
  "after": "तैलघृतलेहयोगा भक्ष्याः प्रवरासवाः सिद्धाः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.06.61a",
  "kind": "metre",
  "line": "व्यायामविधिर्विविधः स्नानान्युद्वर्तनानि गन्धाश्च।",
  "before": "तैलघृतलेहयोगा भक्ष्याः प्रवरासवाः सिद्धाः॥",
  "after": "मेहानां प्रशमार्थं चिकित्सिते दिष्टमेतावत्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.1",
  "kind": "metre",
  "line": "अथातः कुष्ठचिकित्सितं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रे चरकप्रतिसंस्कृते चिकित्सितस्थाने प्रमेहचिकित्सितं नाम षष्ठोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "13 aksharas"
 },
 {
  "id": "06.07.13",
  "kind": "metre",
  "line": "अत ऊर्ध्वमष्टादशानां कुष्ठानां कपालोदुम्बरमण्डलर्ष्यजिह्वपुण्डरीकसिध्मकाकणकैककुष्ठचर्माख्यकिटिमविपादिकालसकदद्रुचर्मदलपामाविस्कोटकशतारुर्विचर्चिकानां (-विस्फोटक-?) लक्षणान्युपदेक्ष्यामः॥",
  "before": "दाहः सुप्ताङ्गता चेति कुष्ठलक्षणमग्रजम्॥",
  "after": "कृष्णारुणकपालाभं यद्रूक्षं परुषं तनु।",
  "note": "82 aksharas"
 },
 {
  "id": "06.07.32a",
  "kind": "metre",
  "line": "दोषस्य यस्य पश्येत् कुष्ठेषु विशेषलिङ्गमुद्रिक्तम्।",
  "before": "यथास्वैर्लक्षणैर्बुद्ध्वा कुष्ठानां क्रियते क्रिया॥",
  "after": "तस्यैव शमं कुर्यात्ततः परं चानुबन्धस्य॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.33a",
  "kind": "metre",
  "line": "कुष्ठविशेषैर्दोषा दोषविशेषैः पुनश्च कुष्ठानि।",
  "before": "तस्यैव शमं कुर्यात्ततः परं चानुबन्धस्य॥",
  "after": "ज्ञायन्ते तैर्हेतुर्हेतुस्तांश्च प्रकाशयति॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.36b",
  "kind": "metre",
  "line": "कुष्ठेषु तु कफलिङ्गं जन्तुभिरभिभक्षणं क्लेदः॥",
  "before": "श्वैत्यं शैत्यं कण्डूः स्थैर्यं चोत्सेधगौरवस्नेहाः।",
  "after": "सर्वैर्लिङ्गैर्युक्तं मतिमान् विवर्जयेदबलम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.38a",
  "kind": "metre",
  "line": "वातकफप्रबलं यद्यदेकदोषोल्बणं न तत् कृच्छ्रम्।",
  "before": "तृष्णादाहपरीतं शान्ताग्निं जन्तुभिर्जग्धम्॥",
  "after": "कफपित्त-वातपित्तप्रबलानि तु कृच्छ्रसाध्यानि॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.38b",
  "kind": "metre",
  "line": "कफपित्त-वातपित्तप्रबलानि तु कृच्छ्रसाध्यानि॥",
  "before": "वातकफप्रबलं यद्यदेकदोषोल्बणं न तत् कृच्छ्रम्।",
  "after": "वातोत्तरेषु सर्पिर्वमनं श्लेष्मोत्तरेषु कुष्ठेषु।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.39a",
  "kind": "metre",
  "line": "वातोत्तरेषु सर्पिर्वमनं श्लेष्मोत्तरेषु कुष्ठेषु।",
  "before": "कफपित्त-वातपित्तप्रबलानि तु कृच्छ्रसाध्यानि॥",
  "after": "पित्तोत्तरेषु मोक्षो रक्तस्य विरेचनं चाग्रे॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.40a",
  "kind": "metre",
  "line": "वमनविरेचनयोगाः कल्पोक्ताः कुष्ठिनां प्रयोक्तव्याः।",
  "before": "पित्तोत्तरेषु मोक्षो रक्तस्य विरेचनं चाग्रे॥",
  "after": "प्रच्छनमल्पे कुष्ठे महति च शस्तं सिराव्यधनम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.40b",
  "kind": "metre",
  "line": "प्रच्छनमल्पे कुष्ठे महति च शस्तं सिराव्यधनम्॥",
  "before": "वमनविरेचनयोगाः कल्पोक्ताः कुष्ठिनां प्रयोक्तव्याः।",
  "after": "बहुदोषः संशोध्यः कुष्ठी बहुशोऽनुरक्षता प्राणान्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.41a",
  "kind": "metre",
  "line": "बहुदोषः संशोध्यः कुष्ठी बहुशोऽनुरक्षता प्राणान्।",
  "before": "प्रच्छनमल्पे कुष्ठे महति च शस्तं सिराव्यधनम्॥",
  "after": "दोषे ह्यतिमात्रहृते वायुर्हन्यादबलमाशु॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.42b",
  "kind": "metre",
  "line": "वायुर्हि शुद्धकोष्ठं कुष्ठिनमबलं विशति शीघ्रम्॥",
  "before": "स्नेहस्य पानमिष्टं शुद्धे कोष्ठे प्रवाहिते रक्ते।",
  "after": "दोषोत्क्लिष्टे हृदये वाम्यः कुष्ठेषु चोर्ध्वभागेषु।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.43b",
  "kind": "metre",
  "line": "कुटजफलमदनमधुकैः सपटोलैर्निम्बरसयुक्तैः॥",
  "before": "दोषोत्क्लिष्टे हृदये वाम्यः कुष्ठेषु चोर्ध्वभागेषु।",
  "after": "शीतरसः पक्वरसो मधूनि मधुकं च वमनानि।",
  "note": "21 aksharas"
 },
 {
  "id": "06.07.44a",
  "kind": "metre",
  "line": "शीतरसः पक्वरसो मधूनि मधुकं च वमनानि।",
  "before": "कुटजफलमदनमधुकैः सपटोलैर्निम्बरसयुक्तैः॥",
  "after": "कुष्ठेषु त्रिवृता दन्ती त्रिफला च विरेचने शस्ता॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.44b",
  "kind": "metre",
  "line": "कुष्ठेषु त्रिवृता दन्ती त्रिफला च विरेचने शस्ता॥",
  "before": "शीतरसः पक्वरसो मधूनि मधुकं च वमनानि।",
  "after": "सौवीरकं तुषोदकमालोडनमासवाश्च सीधूनि।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.45a",
  "kind": "metre",
  "line": "सौवीरकं तुषोदकमालोडनमासवाश्च सीधूनि।",
  "before": "कुष्ठेषु त्रिवृता दन्ती त्रिफला च विरेचने शस्ता॥",
  "after": "शंसन्त्यधोहराणां यथाविरेकं क्रमश्चेष्टः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.46a",
  "kind": "metre",
  "line": "दार्वीबृहतीसेव्यैः पटोलपिचुमर्दमदनकृतमालैः।",
  "before": "शंसन्त्यधोहराणां यथाविरेकं क्रमश्चेष्टः॥",
  "after": "सस्नेहैरास्थाप्यः कुष्ठी सकलिङ्गयवमुस्तैः॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.07.47a",
  "kind": "metre",
  "line": "वातोल्बणं विरिक्तं निरूढमनुवासनार्हमालक्ष्य।",
  "before": "सस्नेहैरास्थाप्यः कुष्ठी सकलिङ्गयवमुस्तैः॥",
  "after": "फलमधुकनिम्बकुटजैः सपटोलैः साधयेत्स्नेहम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.47b",
  "kind": "metre",
  "line": "फलमधुकनिम्बकुटजैः सपटोलैः साधयेत्स्नेहम्॥",
  "before": "वातोल्बणं विरिक्तं निरूढमनुवासनार्हमालक्ष्य।",
  "after": "सैन्धवदन्तीमरिचं फणिज्झकः पिप्पली करञ्जफलम्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.48a",
  "kind": "metre",
  "line": "सैन्धवदन्तीमरिचं फणिज्झकः पिप्पली करञ्जफलम्।",
  "before": "फलमधुकनिम्बकुटजैः सपटोलैः साधयेत्स्नेहम्॥",
  "after": "नस्यं स्यात्सविडङ्गं क्रिमिकुष्ठ-कफप्रकोपघ्नम्॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.50a",
  "kind": "metre",
  "line": "स्थिरकठिनमण्डलानां स्विन्नानां प्रस्तरप्रणाडीभिः।",
  "before": "कृमयः कुष्ठकिलासाः प्रयोजितैरुत्तमाङ्गस्थाः॥",
  "after": "कूर्चैर्विघट्टितानां रक्तोत्क्लेशोऽपनेतव्यः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.52a",
  "kind": "metre",
  "line": "रुधिरागमार्थमथवा शृङ्गालाबूनि योजयेत् कुष्ठे।",
  "before": "स्विन्नोत्सन्नं विलिखेत् कुष्ठं तीक्ष्णेन शस्त्रेण॥",
  "after": "प्रच्छितमल्पं कुष्ठं विरेचयेद्वा जलौकोभिः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.54a",
  "kind": "metre",
  "line": "येषु न शस्त्रं क्रमते स्पर्शेन्द्रियनाशनानि यानि स्युः।",
  "before": "संशोधिताशयानां सद्यः सिद्धिर्भवेत्तेषाम्॥",
  "after": "तेषु निपात्यः क्षारो रक्तं दोषं च विस्राव्य॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.55a",
  "kind": "metre",
  "line": "पाषाणकठिनपरुषे सुप्ते कुष्ठे स्थिरे पुराणे च।",
  "before": "तेषु निपात्यः क्षारो रक्तं दोषं च विस्राव्य॥",
  "after": "पीतागदस्य कार्यो विषैः प्रदेहोऽगदैश्चानु॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.56a",
  "kind": "metre",
  "line": "स्तब्धानि सुप्तसुप्तान्यस्वेदनकण्डुलानि कुष्ठानि।",
  "before": "पीतागदस्य कार्यो विषैः प्रदेहोऽगदैश्चानु॥",
  "after": "कूर्चैर्दन्तीत्रिवृताकरवीरकरञ्जकुटजानाम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.56b",
  "kind": "metre",
  "line": "कूर्चैर्दन्तीत्रिवृताकरवीरकरञ्जकुटजानाम्॥",
  "before": "स्तब्धानि सुप्तसुप्तान्यस्वेदनकण्डुलानि कुष्ठानि।",
  "after": "जात्यर्कनिम्बजैर्वा पत्रैः शस्त्रैः समुद्रफेनैर्वा।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.58a",
  "kind": "metre",
  "line": "मारुतकफकुष्ठघ्नं कर्मोक्तं पित्तकुष्ठिनां कार्यम्।",
  "before": "घृष्टानि गोमयैर्वा ततः प्रदेहैः प्रदेह्यानि॥",
  "after": "कफपित्तरक्तहरणं तिक्तकषायैः प्रशमनं च॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.58b",
  "kind": "metre",
  "line": "कफपित्तरक्तहरणं तिक्तकषायैः प्रशमनं च॥",
  "before": "मारुतकफकुष्ठघ्नं कर्मोक्तं पित्तकुष्ठिनां कार्यम्।",
  "after": "सर्पींषि तिक्तकानि च यच्चान्यद्रक्तपित्तनुत् कर्म।",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.59a",
  "kind": "metre",
  "line": "सर्पींषि तिक्तकानि च यच्चान्यद्रक्तपित्तनुत् कर्म।",
  "before": "कफपित्तरक्तहरणं तिक्तकषायैः प्रशमनं च॥",
  "after": "बाह्याभ्यन्तरमग्र्यं तत् कार्यं पित्तकुष्ठेषु॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.66a",
  "kind": "metre",
  "line": "चूर्णं तर्पणभागैर्नवभिः संयोजितं समध्वाज्यम्।",
  "before": "सप्तच्छदनिम्बत्वक् सविशालश्चित्रको मूर्वा॥",
  "after": "सिद्धं कुष्ठनिबर्हणमेतत् प्रायोगिकं भक्ष्यम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.67a",
  "kind": "metre",
  "line": "श्वयथुं सपाण्डुरोगं श्वित्रं ग्रहणीप्रदोषमर्शांसि।",
  "before": "सिद्धं कुष्ठनिबर्हणमेतत् प्रायोगिकं भक्ष्यम्॥",
  "after": "ब्रघ्नभगन्दरपिडकाकण्डूकोठांश्च विनिहन्ति॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.67b",
  "kind": "metre",
  "line": "ब्रघ्नभगन्दरपिडकाकण्डूकोठांश्च विनिहन्ति॥",
  "before": "श्वयथुं सपाण्डुरोगं श्वित्रं ग्रहणीप्रदोषमर्शांसि।",
  "after": "इति मुस्तादिचूर्णम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.67c",
  "kind": "metre",
  "line": "इति मुस्तादिचूर्णम्।",
  "before": "ब्रघ्नभगन्दरपिडकाकण्डूकोठांश्च विनिहन्ति॥",
  "after": "त्रिफलातिविषाकटुकानिम्बकलिङ्गकवचापटोलानाम्।",
  "note": "7 aksharas"
 },
 {
  "id": "06.07.68a",
  "kind": "metre",
  "line": "त्रिफलातिविषाकटुकानिम्बकलिङ्गकवचापटोलानाम्।",
  "before": "इति मुस्तादिचूर्णम्।",
  "after": "मागधिकारजनीद्वयपद्मकमूर्वाविशालानाम्॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.07.68b",
  "kind": "metre",
  "line": "मागधिकारजनीद्वयपद्मकमूर्वाविशालानाम्॥",
  "before": "त्रिफलातिविषाकटुकानिम्बकलिङ्गकवचापटोलानाम्।",
  "after": "भूनिम्बपलाशानां दद्याद्द्विपलं ततस्त्रिवृद्द्विगुणा।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.69a",
  "kind": "metre",
  "line": "भूनिम्बपलाशानां दद्याद्द्विपलं ततस्त्रिवृद्द्विगुणा।",
  "before": "मागधिकारजनीद्वयपद्मकमूर्वाविशालानाम्॥",
  "after": "तस्याश्च पुनर्ब्राह्मी तच्चूर्णं सुप्तिनुत् परमम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.70a",
  "kind": "metre",
  "line": "लेलीतकप्रयोगो रसेन जात्याः समाक्षिकः परमः।",
  "before": "तस्याश्च पुनर्ब्राह्मी तच्चूर्णं सुप्तिनुत् परमम्॥",
  "after": "सप्तदशकुष्ठघाती माक्षिकधातुश्च मूत्रेण॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.71b",
  "kind": "metre",
  "line": "सर्वव्याधिनिबर्हणमद्यात् कुष्ठी रसं च निगृहीतम्॥",
  "before": "श्रेष्ठं गन्धकयोगात् सुवर्णमाक्षिकप्रयोगाद्वा।",
  "after": "वज्रशिलाजतुसहितं सहितं वा योगराजेन।",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.72a",
  "kind": "metre",
  "line": "वज्रशिलाजतुसहितं सहितं वा योगराजेन।",
  "before": "सर्वव्याधिनिबर्हणमद्यात् कुष्ठी रसं च निगृहीतम्॥",
  "after": "सर्वव्याधिप्रशमनमद्यात्कुष्ठी निगृह्य नित्यं च॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.72b",
  "kind": "metre",
  "line": "सर्वव्याधिप्रशमनमद्यात्कुष्ठी निगृह्य नित्यं च॥",
  "before": "वज्रशिलाजतुसहितं सहितं वा योगराजेन।",
  "after": "खदिरसुरदारुसारं श्रपयित्वा तद्रसेन तोयार्थः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.73a",
  "kind": "metre",
  "line": "खदिरसुरदारुसारं श्रपयित्वा तद्रसेन तोयार्थः।",
  "before": "सर्वव्याधिप्रशमनमद्यात्कुष्ठी निगृह्य नित्यं च॥",
  "after": "क्षौद्रप्रस्थे कार्यः कार्ये ते चाष्टपलिके च॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.75a",
  "kind": "metre",
  "line": "मत्स्यण्डिका मधुसमा तन्मासं जातमायसे भाण्डे।",
  "before": "त्रिफलैले त्वङ्मरिचं पत्रं कनकं च कर्षांशम्॥",
  "after": "मध्वासवमाचरतः कुष्ठकिलासे शमं यातः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.75c",
  "kind": "metre",
  "line": "इति मध्वासवः।",
  "before": "मध्वासवमाचरतः कुष्ठकिलासे शमं यातः॥",
  "after": "खदिरकषायद्रोणं कुम्भे घृतभाविते समावाप्य।",
  "note": "6 aksharas"
 },
 {
  "id": "06.07.76a",
  "kind": "metre",
  "line": "खदिरकषायद्रोणं कुम्भे घृतभाविते समावाप्य।",
  "before": "इति मध्वासवः।",
  "after": "द्रव्याणि चूर्णितानि च षट्पलिकान्यत्र देयानि॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.77a",
  "kind": "metre",
  "line": "त्रिफलाव्योषविडङ्गरजनीमुस्ताटरूषकेन्द्रयवाः।",
  "before": "द्रव्याणि चूर्णितानि च षट्पलिकान्यत्र देयानि॥",
  "after": "सौवर्णी च तथा त्वक् छिन्नरुहा चेति तन्मासम्॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.78a",
  "kind": "metre",
  "line": "निदधीत धान्यमध्ये प्रातः प्रातः पिबेत्ततो युक्त्या।",
  "before": "सौवर्णी च तथा त्वक् छिन्नरुहा चेति तन्मासम्॥",
  "after": "मासेन महाकुष्ठं हन्त्येवाल्पं तु पक्षेण॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.79a",
  "kind": "metre",
  "line": "अर्शःश्वासभगन्दरकासकिलासप्रमेहशोषांश्च।",
  "before": "मासेन महाकुष्ठं हन्त्येवाल्पं तु पक्षेण॥",
  "after": "ना भवति कनकवर्णः पीत्वारिष्टं कनकबिन्दुम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.79b",
  "kind": "metre",
  "line": "ना भवति कनकवर्णः पीत्वारिष्टं कनकबिन्दुम्॥",
  "before": "अर्शःश्वासभगन्दरकासकिलासप्रमेहशोषांश्च।",
  "after": "इति कनकबिन्द्वरिष्टम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.80a",
  "kind": "metre",
  "line": "कुष्ठेष्वनिलकफकृतेष्वेवं पेयस्तथापि पैत्तेषु।",
  "before": "इति कनकबिन्द्वरिष्टम्।",
  "after": "कृतमालक्वाथश्चाप्येष विशेषात् कफकृतेषु॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.81a",
  "kind": "metre",
  "line": "त्रिफलासवश्च गौडः सचित्रकः कुष्ठरोगविनिहन्ता।",
  "before": "कृतमालक्वाथश्चाप्येष विशेषात् कफकृतेषु॥",
  "after": "क्रमुकदशमूलदन्तीवराङ्गमधुयोगसंयुक्तः॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.81b",
  "kind": "metre",
  "line": "क्रमुकदशमूलदन्तीवराङ्गमधुयोगसंयुक्तः॥",
  "before": "त्रिफलासवश्च गौडः सचित्रकः कुष्ठरोगविनिहन्ता।",
  "after": "लघूनि चान्नानि हितानि विद्यात् कुष्ठेषु शाकानि च तिक्तकानि।",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.85a",
  "kind": "metre",
  "line": "चित्रकमेलां बिम्बीं वृषकं त्रिवृदर्कनागरकम्।",
  "before": "कुष्ठालेपनमिष्टं रसाञ्जनं चाभया चैव॥",
  "after": "चूर्णीकृतमष्टाहं भावयितव्यं पलाशस्य॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.86a",
  "kind": "metre",
  "line": "क्षारेण गवां मूत्रस्रुतेन तेनास्य मण्डलान्याशु।",
  "before": "चूर्णीकृतमष्टाहं भावयितव्यं पलाशस्य॥",
  "after": "भिद्यन्ते विलयन्ति च लिप्तान्यर्काभितप्तानि॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.87a",
  "kind": "metre",
  "line": "मांसी मरिचं लवणं रजनी तगरं सुधा गृहाद्धूमः।",
  "before": "भिद्यन्ते विलयन्ति च लिप्तान्यर्काभितप्तानि॥",
  "after": "मूत्रं पित्तं क्षारः पालाशः कुष्ठहा लेपः॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.87b",
  "kind": "metre",
  "line": "मूत्रं पित्तं क्षारः पालाशः कुष्ठहा लेपः॥",
  "before": "मांसी मरिचं लवणं रजनी तगरं सुधा गृहाद्धूमः।",
  "after": "त्रपु सीसमयश्चूर्णं मण्डलनुत् फल्गुचित्रकौ बृहती।",
  "note": "14 aksharas"
 },
 {
  "id": "06.07.88a",
  "kind": "metre",
  "line": "त्रपु सीसमयश्चूर्णं मण्डलनुत् फल्गुचित्रकौ बृहती।",
  "before": "मूत्रं पित्तं क्षारः पालाशः कुष्ठहा लेपः॥",
  "after": "गोधारसः सलवणो दारु च मूत्रं च मण्डलनुत्॥",
  "note": "20 aksharas"
 }
