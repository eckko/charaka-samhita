[
 {
  "id": "07.01.25",
  "kind": "metre",
  "line": "एतेनैव च कल्पेन सुमुख-सुरस-कुठेरक-काण्डीर-कालमालक-पर्णासक-क्षवक-फणिज्झक-गृञ्जन-कासमर्द-भृङ्गराजानां पोटेक्षुवालिका-कालङ्कतक-दण्डैरकाणां चान्यतमस्य कषायेण कारयेत्॥",
  "before": "फलपिप्पलीस्वरसकषायपरिभावितानि तिलशालितण्डुलपिष्टानि तत्क्षायोपसर्जनानि शष्कुलीकल्पेन वा शाष्कुल्यः, पूपकल्पेन वा पूपाः, इति समानं पूर्वेण॥",
  "after": "तथा बदरषाडव-राग-लेह-मोदकोत्कारिका-तर्पण-पानक-मांसरस-यूष-मद्यानां मदनफलान्यन्यतमेनोपसृज्य यथादोषरोगभक्ति दद्यात्; तैः साधुवमतीति॥",
  "note": "77 aksharas"
 },
 {
  "id": "07.01.26",
  "kind": "metre",
  "line": "तथा बदरषाडव-राग-लेह-मोदकोत्कारिका-तर्पण-पानक-मांसरस-यूष-मद्यानां मदनफलान्यन्यतमेनोपसृज्य यथादोषरोगभक्ति दद्यात्; तैः साधुवमतीति॥",
  "before": "एतेनैव च कल्पेन सुमुख-सुरस-कुठेरक-काण्डीर-कालमालक-पर्णासक-क्षवक-फणिज्झक-गृञ्जन-कासमर्द-भृङ्गराजानां पोटेक्षुवालिका-कालङ्कतक-दण्डैरकाणां चान्यतमस्य कषायेण कारयेत्॥",
  "after": "मदनः करहाटश्च राठः पिण्डीतकः फलम्।",
  "note": "63 aksharas"
 },
 {
  "id": "07.01.28a",
  "kind": "metre",
  "line": "तत्र श्लोकाः---",
  "before": "श्वसनश्चेति पर्यायैरुच्यते तस्य कल्पना॥",
  "after": "नव योगाः कषायेषु, मात्रास्वष्टौ, पयोघृते।",
  "note": "4 aksharas"
 },
 {
  "id": "07.02.1",
  "kind": "metre",
  "line": "अथातो जीमूतककल्पं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रे चरकप्रतिसंस्कृतेऽप्राप्ते दृढबलसंपूरिते कल्पस्थाने मदनकल्पो नाम प्रथमोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "13 aksharas"
 },
 {
  "id": "07.02.14a",
  "kind": "metre",
  "line": "तत्र श्लोकौ---",
  "before": "फलादीनां कषायेण श्रेष्ठं तद्वमनं मतम्॥",
  "after": "षट् क्षीरे मदिरामण्डे एको द्वादश चापरे।",
  "note": "4 aksharas"
 },
 {
  "id": "07.03.21a",
  "kind": "metre",
  "line": "तत्र श्लोकाः---",
  "before": "नरः साधु वमत्येवं न च दौर्बल्यमश्नुते॥",
  "after": "पयस्यष्टौ सुरामण्ड-मस्तु-तक्रेषु च त्रयः।",
  "note": "4 aksharas"
 },
 {
  "id": "07.04.1",
  "kind": "metre",
  "line": "अथातो धामार्गवकल्पं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रे चरकप्रतिसंस्कृतेऽप्राप्ते दृढबलसंपूरिते कल्पस्थाने इक्ष्वाकुकल्पो नाम तृतीयोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "13 aksharas"
 },
 {
  "id": "07.04.19a",
  "kind": "metre",
  "line": "तत्र श्लोकौ---",
  "before": "तच्छृतक्षीरजं सर्पिः साधितं वा फलादिभिः॥",
  "after": "पल्लवे नव चत्वारः क्षीर एकः सुरासवे।",
  "note": "4 aksharas"
 },
 {
  "id": "07.05.12a",
  "kind": "metre",
  "line": "तत्र श्लोकः---",
  "before": "कृशरेणाथवा युक्तं विदध्याद्वमनं भिषक्॥",
  "after": "कषायैर्नव चूर्णैश्च पञ्चोक्ताः सलिलैस्त्रयः।",
  "note": "4 aksharas"
 },
 {
  "id": "07.06.1",
  "kind": "metre",
  "line": "अथातः कृतवेधनकल्पं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रे चरकप्रतिसंस्कृतेऽप्राप्ते दृढबलसंपूरिते कल्पस्थाने वत्सककल्पो नाम पञ्चमोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "14 aksharas"
 },
 {
  "id": "07.06.13a",
  "kind": "metre",
  "line": "तत्र श्लोकौ---",
  "before": "क्ष्वेडं कासी पिबेत् सिद्धं मिश्रमिक्षुरसेन च॥",
  "after": "क्षीरे द्वौ द्वौ सुरा चैका क्वाथा द्वाविंशतिस्तथा।",
  "note": "4 aksharas"
 },
 {
  "id": "07.07.1",
  "kind": "metre",
  "line": "अथातः श्यामात्रिवृत्कल्पं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रे चरकप्रतिसंस्कृतेऽप्राप्ते दृढबलसंपूरिते कल्पस्थाने कृतवेधनकल्पो नाम षष्ठोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "13 aksharas"
 },
 {
  "id": "07.07.75a",
  "kind": "metre",
  "line": "भवतश्चात्र---",
  "before": "त्रिवृच्चूर्णेन संयुज्य विरेकार्थं प्रयोजयेत्॥",
  "after": "त्वक्केशराम्रातकदाडिमैलासितोपलामाक्षिकमातुलुङ्गैः।",
  "note": "5 aksharas"
 },
 {
  "id": "07.07.77a",
  "kind": "metre",
  "line": "तत्र श्लोकाः---",
  "before": "हृद्यांश्च मृत्पुष्पफलप्रवालानम्लं च दद्यादुपजिघ्रणार्थम्॥",
  "after": "एकोऽम्लादिभिरष्टौ च दश द्वौ सैन्धवादिभिः।",
  "note": "4 aksharas"
 },
 {
  "id": "07.08.1",
  "kind": "metre",
  "line": "अथातश्चतुरङ्गुलकल्पं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रे चरकप्रतिसंस्कृतेऽप्राप्ते दृढबलसंपूरिते कल्पस्थाने श्यामात्रिवृत्कल्पो नाम सप्तमोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "14 aksharas"
 },
 {
  "id": "07.08.17a",
  "kind": "metre",
  "line": "तत्र श्लोकाः---",
  "before": "लवणं वा भवेत्तेन युक्तं दद्याद्विरेचनम्॥",
  "after": "द्राक्षारसे सुरासीध्वोर्दध्नि चामलकीरसे।",
  "note": "4 aksharas"
 },
 {
  "id": "07.09.17a",
  "kind": "metre",
  "line": "तत्र श्लोकौ---",
  "before": "चतुरङ्गुलकल्पेन सर्पिषी द्वे च साधयेत्॥",
  "after": "पञ्च दध्यादिभिस्त्वेका सुरा सौवीरकेण च।",
  "note": "4 aksharas"
 },
 {
  "id": "07.10.21a",
  "kind": "metre",
  "line": "तत्र श्लोकौ---",
  "before": "सुरां वा कारयेत् क्षीरे घृतं वा पूर्ववत् पचेत्॥",
  "after": "सौवीरकादिभिः सप्त सर्पिषा च रसेन च।",
  "note": "4 aksharas"
 },
 {
  "id": "07.11.18a",
  "kind": "metre",
  "line": "तत्र श्लोकौ---",
  "before": "अजगन्धाजशृङ्ग्योश्च तद्वत् स्यातां विरेचने॥",
  "after": "कषाया दश षट् तैलेऽष्टौ च सर्पिषि।",
  "note": "4 aksharas"
 },
 {
  "id": "07.11.18b",
  "kind": "metre",
  "line": "कषाया दश षट् तैलेऽष्टौ च सर्पिषि।",
  "before": "तत्र श्लोकौ---",
  "after": "पञ्च मद्ये त्रयो लेहा योगः कम्पिल्लके तथा॥",
  "note": "13 aksharas"
 },
 {
  "id": "07.12.1",
  "kind": "metre",
  "line": "अथातो दन्तीद्रवन्तीकल्पं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रे चरकप्रतिसंस्कृतेऽप्राप्ते दृढबलसंपूरिते कल्पस्थाने सप्तलाशाङ्खिनीकल्पो नामैकादशोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "14 aksharas"
 },
 {
  "id": "07.12.36a",
  "kind": "metre",
  "line": "तत्र श्लोकाः---",
  "before": "सुराकम्पिल्लके योगौ लोध्रवच्च तयोः स्मृतौ॥",
  "after": "(दध्यादिषु त्रयः पञ्च प्रियालाद्यैस्त्रयो रसे।",
  "note": "4 aksharas"
 },
 {
  "id": "07.12.43a",
  "kind": "metre",
  "line": "भवन्ति चात्र---",
  "before": "प्राधान्यतः समाश्रित्य द्रव्याणि दश पञ्च च॥",
  "after": "यद्धि येन प्रधानेन द्रव्यं समुपसृज्यते।",
  "note": "5 aksharas"
 },
 {
  "id": "07.12.106a",
  "kind": "metre",
  "line": "तत्र श्लोकौ---",
  "before": "कालिङ्गान्मागधं श्रेष्ठमेवं मानविदो विदुः॥",
  "after": "कल्पार्थः शोधनं संज्ञा पृथग्घेतुः प्रवर्तने।",
  "note": "4 aksharas"
 },
 {
  "id": "01.01.88b",
  "kind": "sample",
  "line": "सौवर्चलं सैन्धवं च विडमौद्भिदमेव च ॥",
  "before": "स्नेहा ह्येते च विहिता वातपित्तकफापहाः ।",
  "after": "सामुद्रेण सहैतानि पञ्च स्युर्लवणानि च ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.01.127b",
  "kind": "sample",
  "line": "धीमता किंचिदादेयं जीवितारोग्यकाङ्क्षिणा ॥",
  "before": "तस्मान्न भिषजा युक्तं युक्तिबाह्येन भेषजम् ।",
  "after": "कुर्यान्निपतितो मूर्ध्नि सशेषं वासवाशनिः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.05.37b",
  "kind": "sample",
  "line": "हृत्कण्ठेन्द्रियसंशुद्धिर्लघुत्वं शिरसः शमः॥",
  "before": "प्रयोगे, स्नैहिके त्वेकं, वैरेच्यं त्रिचतुः पिबेत्।",
  "after": "यथेरितानां दोषाणां सम्यक्पीतस्य लक्षणम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.05.43b",
  "kind": "sample",
  "line": "न मद्यदुग्धे पीत्वा च न स्नेहं न च माक्षिकम्॥",
  "before": "न मूर्च्छाभ्रमतृष्णासु न क्षीणे नापि च क्षते।",
  "after": "धूमं न भुक्त्वा दध्ना च न रूक्षः क्रुद्ध एव च।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.05.72b",
  "kind": "sample",
  "line": "निहन्ति गन्धं वैरस्यं जिह्वादन्तास्यजं मलम्॥",
  "before": "भक्षयेद्दन्तपवनं दन्तमांसान्यबाधयन्।",
  "after": "निष्कृष्य रुचिमाधत्ते सद्यो दन्तविशोधनम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.05.111a",
  "kind": "sample",
  "line": "शौचे संहरणे लोम्नां पादत्रच्छत्रधारणे।",
  "before": "स्नाने वाससि शुद्धे च सौगन्ध्ये रत्नधारणे॥",
  "after": "गुणा मात्राशितीयेऽस्मिंस्तथोक्ता दण्डधारणे॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.06.8c",
  "kind": "sample",
  "line": "मध्ये मध्यबलं त्वन्ते श्रेष्ठमग्रे च निर्दिशेत् ॥",
  "before": "आदावन्ते च दौर्बल्यं विसर्गादानयोर्नृणाम् ।",
  "after": "शीते शीतानिलस्पर्शसंरूद्धो बलिनां बली ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.07.18a",
  "kind": "sample",
  "line": "हिक्का श्वासोऽरुचिः कम्पो विबन्धो हृदयोरसोः ।",
  "before": "हितं वातघ्नमाध्यं च घृतं चौत्तरभक्तिकम् ॥",
  "after": "उद्गारनिग्रहात्तत्र हिक्कायास्तुल्यमौषधम् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.07.26b",
  "kind": "sample",
  "line": "साहसानामश्चस्तानां मनोवाक्कायकर्मणाम् ॥",
  "before": "इमांस्तु धारयेद्वेगान् हितार्थी प्रेत्य चेह च ।",
  "after": "लोभशोकभयक्रोधमानवेगान् विधारयेत् ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.07.36b",
  "kind": "sample",
  "line": "हितं क्रमेण सेवेत क्रमश्चात्रोपदिश्यते ॥",
  "before": "उचितादहिताद्धीमान् क्रमशो विरमेन्नरः ।",
  "after": "प्रक्षेपापचये ताभ्यां क्रमः पादांशिको भवेत् ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.08.23",
  "kind": "sample",
  "line": "न सतो न गुरून् परिवदेत् नाशुचिरभिचारकर्मचैत्यपूज्यपूजाध्ययनमभिनिर्वर्तयेत् ॥",
  "before": "न रजस्वलां नातुरां नामेध्यां नाशस्तां नानिष्टरूपाचारोपचारां नादक्षां नादक्षिणां नाकामां नान्यकामां नान्यस्त्रियं नान्ययोनिं नायोनौ न चैत्यचत्वरचतुष्पथोपवनश्मशानाघातनसलिलौषधिद्विजगुरुसुरालयेषु न सन्ध्ययोर्नातिथिषु नाशुचिर्नाजग्धभेषजो नाप्रणीतसङ्कल्पो नानुपस्थितप्रहर्षो नाभुक्तवान्नात्यशितो न विषमस्थो न मूत्रोच्चारपीडितो न श्रमव्यायामोपवासक्लमाभिहतो नारहसि व्यवायं गच्छेत् ॥",
  "after": "न विद्युत्स्वनार्तवीषु नाभ्युदितासु दिक्षु नाग्निसंप्लवे न भूमिकम्पे न महोत्सवे नोल्कापाते न महाग्रहोपगमने न नष्टचन्द्रायां तिथौ न सन्ध्ययोर्नामुखाद्गुरोर्नावपतितं नातिमात्रं न तान्तं न विस्वरं नानवस्थितपदं नातिद्रुतं न विलम्बितं नातिक्लीबं नात्युच्चरिनातिनीचैः स्वरैरध्ययनमभ्यस्येत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.09.16a",
  "kind": "sample",
  "line": "पाणिचाराद्यथाचक्षुरज्ञानाद्भीतभीतवत् ।",
  "before": "वरमात्मा हुतोऽज्ञेन न चिकित्सा प्रवर्तिता ॥",
  "after": "नौर्मारुतवशेवाज्ञो भिषक् चरति कर्मसु ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.13.20b",
  "kind": "sample",
  "line": "मूर्च्छां पिपासामुन्मादं कामलां वा समीरयेत्॥",
  "before": "अत्युष्णे वा दिवा पीतो वातपित्ताधिकेन व।",
  "after": "शीते रात्रौ पिबन् स्नेहं नरः श्लेष्माधिकोऽपि वा।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.13.69a",
  "kind": "sample",
  "line": "उदीर्णपित्ताल्पकफा ग्रहणी मन्दमारुता।",
  "before": "भवति क्रूरकोष्ठस्य ग्रहण्यत्युल्बणानिला॥",
  "after": "मृदुकोष्ठस्य तस्मात् स सुविरेच्यो नरः स्मृतः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.13.76b",
  "kind": "sample",
  "line": "शूलमामप्रदोषाश्च जायन्ते स्नेहविभ्रमात्॥",
  "before": "जठरं ग्रहणीदोषाः स्तैमित्यं वाक्यनिग्रहः।",
  "after": "तत्रप्युल्लेखनं शस्तं स्वेदः कालप्रतीक्षणम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.13.94b",
  "kind": "sample",
  "line": "क्षीरसर्पिश्च तत् सिद्धं स्नेहनीयं घृतोत्तमम्॥",
  "before": "यवकोलकुलत्थानां रसाः क्षारः सुरा दधि।",
  "after": "तैलमज्जवसासर्पिर्बदरत्रिफलारसैः।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.15.2",
  "kind": "sample",
  "line": "इति ह स्माह भगवानात्रेयः ॥",
  "before": "अथात उपकल्पनीयमध्यायं व्याख्यास्यामः ॥",
  "after": "इह खलु राजानां आजमात्रमन्यं वा विपुलद्रव्यं वमनं विरेचनं वा पाययितुकामेन भिषजा प्रागेवैषधपानात् संभारा उपकल्पनीया भवन्ति सम्यक्चैव हि गच्छत्यौषधे प्रतिभोगार्थाः, न हि सन्निकृष्टे काले प्रादुर्भूतायामापदि सतय्पि क्रयाक्रये सुकरमांशु संभरणमौषधानां यथावदिति ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.17.52a",
  "kind": "sample",
  "line": "निद्रां तन्द्राम् प्रलापं च हृद्रोगं गात्रगौरवम् ।",
  "before": "कुर्वीत सन्निरुन्धानो मृद्वग्नित्वं शिरोग्रहम् ॥",
  "after": "नखादीनां च पीतत्वं ष्ठीवनं कफपित्तयोः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.19.7a",
  "kind": "sample",
  "line": "आगन्तुरन्वेति निजं विकारं निजस्तथागन्तुमपि प्रवृद्धः ।",
  "before": "न ते पृथक् पित्तकफानिलेभ्य आगन्तवस्त्वेव ततो विशिष्टाः ॥",
  "after": "तत्रानुबन्धं प्रकृतिं च सम्यग् ज्ञात्वा ततः कर्म समारभेत ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.22.36b",
  "kind": "sample",
  "line": "क्षुत्प्रणाशोऽरुचिस्तृष्णा दौर्बल्यं श्रोत्रनेत्रयोः॥",
  "before": "पर्वभेदोऽङ्गमर्दश्च कासः शोषो मुखस्य च।",
  "after": "मनसः संभ्रमोऽभीक्ष्णमूर्ध्ववातस्तमो हृदि।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.26.45c",
  "kind": "sample",
  "line": "तयोरम्लं यदुष्णं च यद्द्रव्यं कटुकं तयोः ॥",
  "before": "शीतं वीर्येण यद्द्रव्यं मधुरं रसपाकयोः ।",
  "after": "तेषां रसोपदेशेन निर्देश्यो गुणसंग्रहः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.27.50a",
  "kind": "sample",
  "line": "शतपत्रो भृङ्गराजः कोयष्टिर्जीवजीवकः।",
  "before": "क्रकरोऽवकरश्चैव वारडश्चेति विष्किराः॥",
  "after": "कैरातः कोकिलोऽत्यूहो गोपापुत्रः प्रियात्मजः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.27.136b",
  "kind": "sample",
  "line": "कपित्थमामं कण्ठघ्नं विषघ्नं ग्राहि वातलम्॥",
  "before": "कषायमधुरं टङ्कं वातलं गुरु शीतलम्।",
  "after": "मधुराम्लकषायत्वात् सौगन्ध्याच्च रुचिप्रदम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.28.45a",
  "kind": "sample",
  "line": "तत्र श्लोकाः",
  "before": "परिहर्तुं न तत् प्राप्य शोचितव्यं मनीषिभिः ॥",
  "after": "आहारसंभवः वस्तु रोगाश्चाहारसंभवाः ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.30.27",
  "kind": "sample",
  "line": "सोऽयमायुर्वेदः शाश्वतो निर्विश्यते अनादित्वात् स्वभावसंसिद्धलक्षणत्वात् भावस्वभावनित्यत्वाच्च ।",
  "before": "प्रयोजनं चास्य स्वस्थस्य स्वास्थ्यरक्षणमायुरस्य विकारप्रशमनं च ॥",
  "after": "न हि नाभूत् कदाचिदायुषः सन्तानो बुद्धिसन्तानो वा शाश्वतश्चायुषो वेदिता अनादि च सुखदुःखं सद्रव्यहेतुलक्षणमपरापरयोगात् ।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.30.71a",
  "kind": "sample",
  "line": "इति सर्वं यथाप्रशनमष्टकं संप्रकाशितम् ।",
  "before": "अधिकृत्यार्थमध्यायनामसंज्ञा प्रतिष्ठिता ॥",
  "after": "कार्त्स्न्येन चोक्तस्तन्त्रस्य संग्रहः सुविनिश्चितः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.03.111b",
  "kind": "sample",
  "line": "आगन्तुरष्टमो यस्तु स निर्दिष्टश्चतुर्विधः॥",
  "before": "संसर्गसन्निपातानां तया चोक्तं स्वलक्षणम्।",
  "after": "अभिघाताभिषङ्गाभ्यामभिचाराभिशापतः।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.03.179a",
  "kind": "sample",
  "line": "यवाग्वोदनलाजार्थे ज्वरितानां ज्वरापहाः।",
  "before": "रक्तशाल्यादयः शस्ताः पुराणाः षष्टिकैः सह॥",
  "after": "लाजपेयां सुखजरां पिप्पलीनागरैः शृताम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.03.229b",
  "kind": "sample",
  "line": "ज्वरे प्रच्छर्दनं शस्तं मद्यैर्वा तर्पणेन वा॥",
  "before": "क्षौद्राम्बुना रसेनेक्षोरथवा लवणाम्बुना।",
  "after": "मृद्वीकामलकानां वा रसं प्रस्कन्दनं पिबेत्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.03.310b",
  "kind": "sample",
  "line": "सोमं सानुचरं देवं समातृगणमीश्वरम्॥",
  "before": "धारणादगदानां च सेवनान्न भवेज्ज्वरः।",
  "after": "पूजयन् प्रयतः शीघ्रं मुच्यते विषमज्वरात्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.03.330a",
  "kind": "sample",
  "line": "सज्वरो ज्वरमुक्तश्च विदाहीनि गुरूणि च।",
  "before": "युक्तं प्रकृतिसत्त्वेन विद्यात् पुरुषमज्वरम्॥",
  "after": "असात्म्यान्यन्नपानानि विरुद्धानि च वर्जयेत्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.04.77c",
  "kind": "sample",
  "line": "योगीन्द्रनाथसेनस् तुइत्य् अत्रपठति,इत्य् अस्यच व्याख्यानं करोति.",
  "before": "एते समस्ता गणशः पृथग्वा रक्तं सपित्तं शमयन्ति योगाः॥",
  "after": "मुद्गाः सलाजाः सयवाः सकृष्णाः सोशीरमुस्ताः सह चन्दनेन।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.04.91a",
  "kind": "sample",
  "line": "अभ्यङ्गयोगाः परिषेचनानि सेकावगाहाः शयनानि वेश्म।",
  "before": "सर्पींषि पित्तज्वरनाशनानि सर्वाणि शस्तानि च रक्तपित्ते॥",
  "after": "शीतो विधिर्बस्तिविधानमग्र्यं पित्तज्वरे यत् प्रशमाय दिष्टम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.05.26a",
  "kind": "sample",
  "line": "पुनः पुनः स्नेहपानं निरूहाः सानुवासनाः।",
  "before": "बृंहणान्यन्नपानानि स्निग्धोष्णानि प्रयोजयेत्॥",
  "after": "प्रयोज्या वातगुल्मेषु कफपित्तानुराक्षिणा॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.05.152b",
  "kind": "sample",
  "line": "द्विगुणं तद्विरेकार्थं प्रयोज्यं कफगुल्मिनाम्॥",
  "before": "यदुक्तं वातगुल्मघ्नं स्रंसनं नीलिनीघृतम्।",
  "after": "सुधाक्षीरद्रवे चूर्णं त्रिवृतायाः सुभावितम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.07.83b",
  "kind": "sample",
  "line": "शस्ता, न गुर्वम्लपयोदधीनि नानूपमत्स्या न गुडस्तिलाश्च॥",
  "before": "पुराणधान्यान्यथ जाङ्गलानि मांसानि मुद्गाश्च पटोलयुक्ताः।",
  "after": "एला कुष्ठं दार्वी शतपुष्पा चित्रको विडङ्गश्च।",
  "note": "ordinary line, no flag"
 }
]