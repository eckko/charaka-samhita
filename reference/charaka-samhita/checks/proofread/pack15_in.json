[
 {
  "id": "06.14.204a",
  "kind": "metre",
  "line": "सिद्धं पलाण्डुशाकं तक्रेणोपोदिकां सबदराम्लाम्।",
  "before": "दध्नः सरेण सिद्धान् दद्याद्रक्ते प्रवृत्तेऽति॥",
  "after": "रुधिरस्रवे प्रदद्यान्मसूरसूपं च तक्राम्लम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.205a",
  "kind": "metre",
  "line": "पयसा शृतेन यूषैर्मसूरमुद्गाढकीमकुष्ठानाम्।",
  "before": "रुधिरस्रवे प्रदद्यान्मसूरसूपं च तक्राम्लम्॥",
  "after": "भोजनमद्यादम्लैः शालिश्यामाककोद्रवजम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.206a",
  "kind": "metre",
  "line": "शशहरिणलावमांसैः कपिञ्जलैणेयकैः सुसिद्धैश्च।",
  "before": "भोजनमद्यादम्लैः शालिश्यामाककोद्रवजम्॥",
  "after": "भोजनमद्यादम्लैर्मधुरैरीषत् समरिचैर्वा॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.14.207b",
  "kind": "metre",
  "line": "अद्याद्रसैरतिवहेष्वर्शःस्वनिलोल्बणशरीरः॥",
  "before": "दक्षशिखितित्तिरिरसैर्द्विककुदलोपाकजैश्च मधुराम्लैः।",
  "after": "रसखडयूषयवागूसंयोगतः केवलोऽथवा जयति।",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.208a",
  "kind": "metre",
  "line": "रसखडयूषयवागूसंयोगतः केवलोऽथवा जयति।",
  "before": "अद्याद्रसैरतिवहेष्वर्शःस्वनिलोल्बणशरीरः॥",
  "after": "रक्तमतिवर्तमानं वातं च पलाण्डुरुपयुक्तः॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.14.208b",
  "kind": "metre",
  "line": "रक्तमतिवर्तमानं वातं च पलाण्डुरुपयुक्तः॥",
  "before": "रसखडयूषयवागूसंयोगतः केवलोऽथवा जयति।",
  "after": "छागान्तराधि तरुणं सरुधिरमुपसाधितं बहुपलाण्डु।",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.210a",
  "kind": "metre",
  "line": "नवनीततिलाभ्यासात् केशरनवनीतशर्कराभ्यासात्।",
  "before": "व्यत्यासान्मधुराम्लं विट्शोणितसंक्षये देयम्॥",
  "after": "दधिसरमथिताभ्यासादर्शांस्यपयान्ति रक्तानि॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.14.210b",
  "kind": "metre",
  "line": "दधिसरमथिताभ्यासादर्शांस्यपयान्ति रक्तानि॥",
  "before": "नवनीततिलाभ्यासात् केशरनवनीतशर्कराभ्यासात्।",
  "after": "नवनीतघृतं छागं मांसं च सषष्टिकः शालिः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.211b",
  "kind": "metre",
  "line": "तरुणश्च सुरामण्डस्तरुणी च सुरा निहन्त्यस्रम्॥",
  "before": "नवनीतघृतं छागं मांसं च सषष्टिकः शालिः।",
  "after": "प्रायेण वातबहुलान्यर्शांसि भवन्त्यतिस्रुते रक्ते।",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.212a",
  "kind": "metre",
  "line": "प्रायेण वातबहुलान्यर्शांसि भवन्त्यतिस्रुते रक्ते।",
  "before": "तरुणश्च सुरामण्डस्तरुणी च सुरा निहन्त्यस्रम्॥",
  "after": "दुष्टेऽपि च कफपित्ते तस्मादनिलोऽधिको ज्ञेयः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.213a",
  "kind": "metre",
  "line": "दृष्ट्वा तु रक्तपित्तं प्रबलं कफावातलिङ्गमल्पं च।",
  "before": "दुष्टेऽपि च कफपित्ते तस्मादनिलोऽधिको ज्ञेयः॥",
  "after": "शीता क्रिया प्रयोज्या यथेरिता वक्ष्यते चान्या॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.214a",
  "kind": "metre",
  "line": "मधुकं सपञ्चवल्कं बदरीत्वगुदुम्बरं धवपटोलम्।",
  "before": "शीता क्रिया प्रयोज्या यथेरिता वक्ष्यते चान्या॥",
  "after": "परिषेचने विदध्याद्वृषककुमयवासनिम्बांश्च॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.14.214b",
  "kind": "metre",
  "line": "परिषेचने विदध्याद्वृषककुमयवासनिम्बांश्च॥",
  "before": "मधुकं सपञ्चवल्कं बदरीत्वगुदुम्बरं धवपटोलम्।",
  "after": "रक्तेऽतिवर्तमाने दाहे क्लेदेऽवगाहयेच्चापि।",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.215b",
  "kind": "metre",
  "line": "मधुकमृणालपद्मकचन्दनकुशकाशनिष्क्वाथे॥",
  "before": "रक्तेऽतिवर्तमाने दाहे क्लेदेऽवगाहयेच्चापि।",
  "after": "इक्षुरसमधुकवेतसनिर्यूहे शीतले पयसि वा तम्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.216a",
  "kind": "metre",
  "line": "इक्षुरसमधुकवेतसनिर्यूहे शीतले पयसि वा तम्।",
  "before": "मधुकमृणालपद्मकचन्दनकुशकाशनिष्क्वाथे॥",
  "after": "अवगाहयेत् प्रदिग्धं पूर्वं शिशिरेण तैलेन॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.14.217a",
  "kind": "metre",
  "line": "दत्त्वा घृतं सशर्करमुपस्थदेशे गुदे त्रिकदेशे च।",
  "before": "अवगाहयेत् प्रदिग्धं पूर्वं शिशिरेण तैलेन॥",
  "after": "शिशिरजलस्पर्शसुखा धारा प्रस्तम्भनी योज्या॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.14.218a",
  "kind": "metre",
  "line": "कदलीदलैरभिनवैः पुष्करपत्रैश्च शीतजलसिक्तैः।",
  "before": "शिशिरजलस्पर्शसुखा धारा प्रस्तम्भनी योज्या॥",
  "after": "प्रच्छादनं मुहुर्मुहुरिष्टं पद्मोत्पलदलैश्च॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.14.219a",
  "kind": "metre",
  "line": "दूर्वाघृतप्रदेहः शतधौतसहस्रधौतमपि सर्पिः।",
  "before": "प्रच्छादनं मुहुर्मुहुरिष्टं पद्मोत्पलदलैश्च॥",
  "after": "व्यजनपवनः सुशीतो रक्तस्रावं जयत्याशु॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.14.220a",
  "kind": "metre",
  "line": "समङ्गामधुकाभ्यां तिलमधुकाभ्यां रसाञ्जनघृताभ्याम्।",
  "before": "व्यजनपवनः सुशीतो रक्तस्रावं जयत्याशु॥",
  "after": "सर्जरसघृताभ्यां वा निम्बघृताभ्यां मधुघृताभ्यां वा॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.14.220b",
  "kind": "metre",
  "line": "सर्जरसघृताभ्यां वा निम्बघृताभ्यां मधुघृताभ्यां वा॥",
  "before": "समङ्गामधुकाभ्यां तिलमधुकाभ्यां रसाञ्जनघृताभ्याम्।",
  "after": "दार्वीत्वक्सर्पिर्भ्यां सचन्दनाभ्यामथोत्पलघृताभ्याम्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.221a",
  "kind": "metre",
  "line": "दार्वीत्वक्सर्पिर्भ्यां सचन्दनाभ्यामथोत्पलघृताभ्याम्।",
  "before": "सर्जरसघृताभ्यां वा निम्बघृताभ्यां मधुघृताभ्यां वा॥",
  "after": "दाहे क्लेदे च गुदभ्रंशे गुदजाः प्रतिसारणीयाः स्युः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.221b",
  "kind": "metre",
  "line": "दाहे क्लेदे च गुदभ्रंशे गुदजाः प्रतिसारणीयाः स्युः॥",
  "before": "दार्वीत्वक्सर्पिर्भ्यां सचन्दनाभ्यामथोत्पलघृताभ्याम्।",
  "after": "आभिः क्रियाभिरथवा शीताभिर्यस्य तिष्ठति न रक्तम्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.222a",
  "kind": "metre",
  "line": "आभिः क्रियाभिरथवा शीताभिर्यस्य तिष्ठति न रक्तम्।",
  "before": "दाहे क्लेदे च गुदभ्रंशे गुदजाः प्रतिसारणीयाः स्युः॥",
  "after": "तं काले स्निग्धोष्णैर्मांसरसैस्तर्पयेन्मतिमान्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.223a",
  "kind": "metre",
  "line": "अवपीडकसर्पिर्भिः कोष्णैर्घृततैलिकैस्तथाभ्यङ्गैः।",
  "before": "तं काले स्निग्धोष्णैर्मांसरसैस्तर्पयेन्मतिमान्॥",
  "after": "क्षीरघृततैलसेकैः कोष्णैस्तमुपाचरेदाशु॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.224a",
  "kind": "metre",
  "line": "कोष्णेन वातप्रबले घृतमण्डेनानुवासयेच्छीघ्रम्।",
  "before": "क्षीरघृततैलसेकैः कोष्णैस्तमुपाचरेदाशु॥",
  "after": "पिच्छाबस्तिं दद्यात् काले तस्याथवा सिद्धम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.14.224b",
  "kind": "metre",
  "line": "पिच्छाबस्तिं दद्यात् काले तस्याथवा सिद्धम्॥",
  "before": "कोष्णेन वातप्रबले घृतमण्डेनानुवासयेच्छीघ्रम्।",
  "after": "यवासकुशकाशानां मूलं पुष्पं च शाल्मलम्।",
  "note": "14 aksharas"
 },
 {
  "id": "06.14.229c",
  "kind": "metre",
  "line": "इति पिच्छाबस्तिः।",
  "before": "पिष्ट्वानुवासनं स्नेहं क्षीरद्विगुणितं पचेत्॥",
  "after": "ह्रीवेरमुत्पलं लोध्रं समङ्गाचव्यचन्दनम्।",
  "note": "6 aksharas"
 },
 {
  "id": "06.14.243a",
  "kind": "metre",
  "line": "भवन्ति चात्र--- व्यत्यासान्मधुराम्लानि शीतोष्णानि च योजयेत्।",
  "before": "इति सुनिषण्णकचाङ्गेरीघृतम्।",
  "after": "नित्यमग्निबलापेक्षी जयत्यर्शःकृतान् गदान्॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.14.249a",
  "kind": "metre",
  "line": "तत्र श्लोकाः---",
  "before": "गुदजाभिपरीतेन तत् सेव्यं न कदाचन॥",
  "after": "अर्शसां द्विविधं जन्म पृथगायतनानि च।",
  "note": "4 aksharas"
 },
 {
  "id": "06.15.121d",
  "kind": "metre",
  "line": "इति तक्रारिष्टः।",
  "before": "दीपनं शोथगुल्मार्शःक्रिमिमेहोदरापहम्॥",
  "after": "स्वस्थानगतमुत्क्लिष्टमग्निनिर्वापकं भिषक्।",
  "note": "6 aksharas"
 },
 {
  "id": "06.15.149c",
  "kind": "metre",
  "line": "इति मधूकासवः।",
  "before": "शोथं कुष्ठं किलासं च प्रमेहांश्च प्रणाशयेत्॥",
  "after": "मधूकपुष्पस्वरसं शृतमर्धक्षयीकृतम्।",
  "note": "7 aksharas"
 },
 {
  "id": "06.15.159c",
  "kind": "metre",
  "line": "इति मूलासवः।",
  "before": "आनाहकफहृद्रोगपाण्डुरोगाङ्गसादनुत्॥",
  "after": "प्रास्थिकं पिप्पलीं पिष्ट्वा गुडं मध्यं बिभीतकात्।",
  "note": "6 aksharas"
 },
 {
  "id": "06.15.162c",
  "kind": "metre",
  "line": "इति पिण्डासवः।",
  "before": "इच्छंस्तेषामनुत्पत्तिं रोगाणां येऽत्र कीर्तिताः॥",
  "after": "नवे पिप्पलिमध्वाक्ते कलसेऽगुरुधूपिते।",
  "note": "6 aksharas"
 },
 {
  "id": "06.15.167c",
  "kind": "metre",
  "line": "इति मध्वरिष्टः।",
  "before": "वातश्लेष्मामयांश्चान्यान्मध्वरिष्टो व्यपोहति॥",
  "after": "समूलां पिप्पलीं क्षारौ द्वौ पञ्च लवणानि च।",
  "note": "6 aksharas"
 },
 {
  "id": "06.15.172c",
  "kind": "metre",
  "line": "इति क्षारघृतम्।",
  "before": "आढकं सर्पिषः पक्त्वा पिबेदग्निविवर्धनम्॥",
  "after": "समूलां पिप्पलीं पाठां चव्येन्द्रयवनागरम्।",
  "note": "6 aksharas"
 },
 {
  "id": "06.15.185c",
  "kind": "metre",
  "line": "इति क्षारगुडिका।",
  "before": "इत्येषा क्षारगुटिका कृष्णात्रेयेण कीर्तिता॥",
  "after": "वत्सकातिविषे पाठां दुःस्पर्शां हिङ्गु चित्रकम्।",
  "note": "7 aksharas"
 },
 {
  "id": "06.15.187c",
  "kind": "metre",
  "line": "इति चतुर्थक्षारः।",
  "before": "मद्यैर्वा ग्रहणीदोषशोथार्शःपाण्डुमान् पिबेत्॥",
  "after": "त्रिफलां कटभीं चव्यं बिल्वमध्यमयोरजः।",
  "note": "7 aksharas"
 },
 {
  "id": "06.15.194b",
  "kind": "metre",
  "line": "इति पञ्चमक्षारः।",
  "before": "जीर्णे रसैर्वा मधुरैरश्नीयात् पयसापि वा।",
  "after": "त्रिदोषे विधिविद्वैद्यः पञ्च कर्माणि कारयेत्॥",
  "note": "7 aksharas"
 },
 {
  "id": "06.15.235b",
  "kind": "metre",
  "line": "भवन्ति चात्र--- पथ्यापथ्यमिहैकत्र भुक्तं समशनं मतम्॥",
  "before": "समधातोः पचत्यन्नं पुष्ट्यायुर्बलवृद्धये।",
  "after": "विषमं बहु वाल्पं वाप्यप्राप्तातीतकालयोः।",
  "note": "21 aksharas"
 },
 {
  "id": "06.15.244a",
  "kind": "metre",
  "line": "तत्र श्लोकाः---",
  "before": "तस्मादन्यत्समश्नीयात्पालयिष्यन्बलायुषी॥",
  "after": "अन्तरग्निगुणा देहं यथा धारयते च सः।",
  "note": "4 aksharas"
 },
 {
  "id": "06.16.1",
  "kind": "metre",
  "line": "अथा पाण्डुरोगचिकित्सितं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रेऽप्राप्ते दृढबलसंपूरिते चिकित्सास्थाने ग्रहणीचिकित्सितं नाम पञ्चदशोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.16.50c",
  "kind": "metre",
  "line": "इति पथ्याघृतम्।",
  "before": "प्रस्थः सिद्धो घृतात् पेयः स पाण्ड्वामयगुल्मनुत्॥",
  "after": "दन्त्याश्चतुष्पलरसे पिष्टैर्दन्तीशलाटुभिः।",
  "note": "6 aksharas"
 },
 {
  "id": "06.16.51c",
  "kind": "metre",
  "line": "इति दन्तीघृतम्।",
  "before": "तद्वत्प्रस्थो घृतात्सिद्धः प्लीहपाण्ड्वर्तिशोफजित्॥",
  "after": "पुराणसर्पिषः प्रस्थो द्राक्षार्धप्रस्थसाधितः।",
  "note": "6 aksharas"
 },
 {
  "id": "06.16.52c",
  "kind": "metre",
  "line": "इति द्राक्षाघृतम्।",
  "before": "कामलागुल्मपाण्ड्वर्तिज्वरमेहोदरापहः॥",
  "after": "हरिद्रात्रिफलानिम्बबलामधुकसाधितम्।",
  "note": "6 aksharas"
 },
 {
  "id": "06.16.87b",
  "kind": "metre",
  "line": "इति योगराजः।",
  "before": "विशेषाद्धन्त्यपस्मारं कामलां गुदजानि च।",
  "after": "कौटजत्रिफलानिम्बपटोलघननागरैः॥",
  "note": "6 aksharas"
 },
 {
  "id": "06.16.102b",
  "kind": "metre",
  "line": "इति धात्र्यवलेहः।",
  "before": "हन्येष कामलां पित्तं पाण्डुं कासं हलीमकम्।",
  "after": "त्र्यूषणं त्रिफला चव्यं चित्रको देवदारु च॥",
  "note": "7 aksharas"
 },
 {
  "id": "06.16.106b",
  "kind": "metre",
  "line": "इति गौडोऽरिष्टः।",
  "before": "लोध्रं चैतेषु गौडः स्यादरिष्टः पाण्डुरोगिणाम्।",
  "after": "बीजकात्षोडशपलं त्रिफलायाश्च विंशतिः॥",
  "note": "6 aksharas"
 },
 {
  "id": "06.16.111b",
  "kind": "metre",
  "line": "इति बीजकारिष्टः।",
  "before": "बीजकारिष्ट इत्येष आत्रेयेण प्रकीर्तितः।",
  "after": "धात्रीफलसहस्रे द्वे पीडयित्वा रसं तु तम्॥",
  "note": "7 aksharas"
 },
 {
  "id": "06.16.114b",
  "kind": "metre",
  "line": "इति धात्र्यरिष्टः।",
  "before": "कासहिक्कारुचिश्वासांश्चैषोऽरिष्टः प्रणाशयेत्।",
  "after": "स्थिरादिभिः शृतं तोयं पानाहारे प्रशस्यते॥",
  "note": "6 aksharas"
 },
 {
  "id": "06.17.26c",
  "kind": "metre",
  "line": "इति महाहिक्का।",
  "before": "महाहिक्केति सा नॄणां सद्यः प्राणहरा मता॥",
  "after": "हिक्कते यः प्रवृद्धस्तु कृशो दीनमना नरः।",
  "note": "6 aksharas"
 },
 {
  "id": "06.17.30c",
  "kind": "metre",
  "line": "इति गम्भीरा हिक्का।",
  "before": "गम्भीरा नाम सा तस्य हिक्का प्राणान्तिकी मता॥",
  "after": "व्यपेता जायते हिक्का यान्नपाने चतुर्विधे।",
  "note": "7 aksharas"
 },
 {
  "id": "06.17.33c",
  "kind": "metre",
  "line": "इति व्यपेता हिक्का।",
  "before": "सा व्यपेतेति विज्ञेया हिक्का प्राणोपरोधिनी॥",
  "after": "क्षुद्रवातो यदा कोष्ठाद्व्यायामपरिघट्टितः।",
  "note": "7 aksharas"
 },
 {
  "id": "06.17.37c",
  "kind": "metre",
  "line": "इति क्षुद्रहिक्का।",
  "before": "मृद्वी सा क्षुद्रहिक्केति नृणां साध्या प्रकीर्तिता॥",
  "after": "सहसात्यभ्यवहृतौः पानान्नैः पीडितोऽनिलः।",
  "note": "6 aksharas"
 },
 {
  "id": "06.17.41c",
  "kind": "metre",
  "line": "इत्यन्नजा हिक्का।",
  "before": "हिक्का पीते तथा भुक्ते शमं याति च सान्नजा॥",
  "after": "अतिसंचितदोषस्य भक्तच्छेदकृशस्य च।",
  "note": "6 aksharas"
 },
 {
  "id": "06.17.48c",
  "kind": "metre",
  "line": "इति महाश्वासः।",
  "before": "महाश्वासोपसृष्टः स क्षिप्रमेव विपद्यते॥",
  "after": "दीर्घं श्वसिति यस्तूर्ध्वं न च प्रत्याहरत्यधः।",
  "note": "6 aksharas"
 },
 {
  "id": "06.17.51c",
  "kind": "metre",
  "line": "इत्यूर्ध्वश्वासः।",
  "before": "मुध्यतस्ताम्यतश्चोर्ध्वं श्वासस्तस्यैव हन्त्यसून्॥",
  "after": "यस्तु श्वसिति विच्छिन्नं सर्वप्राणेन पीडितः।",
  "note": "5 aksharas"
 },
 {
  "id": "06.17.54c",
  "kind": "metre",
  "line": "इति छिन्नश्वासः।",
  "before": "छिन्नश्वासेन विच्छिन्नः स शीघ्रं प्रजहात्यसून्॥",
  "after": "प्रतिलोमं यदा वायुः स्रोतांसि प्रतिपद्यते।",
  "note": "6 aksharas"
 },
 {
  "id": "06.17.62c",
  "kind": "metre",
  "line": "इति तमकश्वासः।",
  "before": "स याप्यस्तमकश्वासः साध्यो वा स्यान्नवोत्थितः॥",
  "after": "ज्वरमूर्च्छापरीतस्य विद्यात् प्रतमकं तु तम्।",
  "note": "7 aksharas"
 },
 {
  "id": "06.17.123a",
  "kind": "metre",
  "line": "शटीचोरकजीवन्तीवन्तीत्वङ्मुस्तं पुष्कराह्वयम्।",
  "before": "यथा तथानिलस्तस्य मार्गं नित्यं विशोधयेत्॥",
  "after": "सुरसं तामलक्येला पिप्पल्यगुरु नागरम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.17.128c",
  "kind": "metre",
  "line": "इति मुक्ताद्यं चूर्णम्।",
  "before": "मल्यं कण्डूमभिष्यन्दमर्म चैव प्रणाशयेत्॥",
  "after": "शटीपुष्करमूलानां चूर्णमामलकस्य च।",
  "note": "7 aksharas"
 }
]