 },
 {
  "id": "06.23.59a",
  "kind": "metre",
  "line": "भूतविषजन्त्वलक्ष्मीकार्मणमन्त्राग्र्यशन्यरीन् हन्यात्।",
  "before": "घ्रेयविलेपनधारणधूमग्रहणैर्गृहस्थश्च॥",
  "after": "दुःस्वप्नस्त्रीदोषानकालमरणाम्बुचैरभयम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.60a",
  "kind": "metre",
  "line": "धनधान्यकार्यसिद्धिः श्रीपुष्ट्यायुर्विवर्धनो धन्यः।",
  "before": "दुःस्वप्नस्त्रीदोषानकालमरणाम्बुचैरभयम्॥",
  "after": "मृतसंजीवन एष प्रागमृताह्ब्रह्मणा विहितः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.60b",
  "kind": "metre",
  "line": "मृतसंजीवन एष प्रागमृताह्ब्रह्मणा विहितः॥",
  "before": "धनधान्यकार्यसिद्धिः श्रीपुष्ट्यायुर्विवर्धनो धन्यः।",
  "after": "इति मृतसंजीवनोऽगदः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.61a",
  "kind": "metre",
  "line": "मन्त्रैर्धमनीबन्धोऽवमार्जनं कार्यमात्मरक्षा च।",
  "before": "इति मृतसंजीवनोऽगदः।",
  "after": "दोषस्य विषं यस्य स्थाने स्यात्तं जयेत्पूर्वम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.62b",
  "kind": "metre",
  "line": "घृतमधुपयोऽम्बुपानावगाहसेकाश्च पित्तस्थे॥",
  "before": "वातस्थाने स्वेदो दध्ना नतकुष्ठकल्कपानं च।",
  "after": "क्षारागदः कफस्थानगते स्वेदस्तथा सिराव्यधनम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.63a",
  "kind": "metre",
  "line": "क्षारागदः कफस्थानगते स्वेदस्तथा सिराव्यधनम्।",
  "before": "घृतमधुपयोऽम्बुपानावगाहसेकाश्च पित्तस्थे॥",
  "after": "दूषीविषेऽथ रक्तस्थिते सिराकर्म पञ्चविधम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.64a",
  "kind": "metre",
  "line": "भेषजमेवं कल्प्यं भिषग्विदालक्ष्य सर्वदा सर्वम्।",
  "before": "दूषीविषेऽथ रक्तस्थिते सिराकर्म पञ्चविधम्॥",
  "after": "स्थानं जयेद्धि पूर्वं स्थानस्थस्याविरुद्धं च॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.65a",
  "kind": "metre",
  "line": "विषदूषितकफमार्गः स्रोतःसंरोधरुद्धवायुस्तु।",
  "before": "स्थानं जयेद्धि पूर्वं स्थानस्थस्याविरुद्धं च॥",
  "after": "मृत इव श्वसेन्मर्त्यः स्यादसाध्यलिङ्गैर्विहीनश्च॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.65b",
  "kind": "metre",
  "line": "मृत इव श्वसेन्मर्त्यः स्यादसाध्यलिङ्गैर्विहीनश्च॥",
  "before": "विषदूषितकफमार्गः स्रोतःसंरोधरुद्धवायुस्तु।",
  "after": "चर्मकषायाः कल्कं बिल्वसमं मूर्ध्नि काकपदमस्य।",
