[
 {
  "id": "06.23.28a",
  "kind": "metre",
  "line": "स्याद्वातिकस्य वातस्थाने कफपित्तलिङ्गमीषत्तु।",
  "before": "दोषस्थानप्रकृतीः प्राप्यान्यतमं ह्युदीरयति॥",
  "after": "तृण्मोहारतिमूर्च्छागलग्रहच्छर्दिफेनादि॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.29a",
  "kind": "metre",
  "line": "पित्ताशयस्थितं पैत्तिकस्य कफवातयोर्विषं तद्वत्।",
  "before": "तृण्मोहारतिमूर्च्छागलग्रहच्छर्दिफेनादि॥",
  "after": "तृट्कासज्वरवमथुक्लमदाहतमोतिसारादि॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.29b",
  "kind": "metre",
  "line": "तृट्कासज्वरवमथुक्लमदाहतमोतिसारादि॥",
  "before": "पित्ताशयस्थितं पैत्तिकस्य कफवातयोर्विषं तद्वत्।",
  "after": "कफदेशगं कफस्य च दर्शयेद्वातपित्तयोश्चेषत्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.30a",
  "kind": "metre",
  "line": "कफदेशगं कफस्य च दर्शयेद्वातपित्तयोश्चेषत्।",
  "before": "तृट्कासज्वरवमथुक्लमदाहतमोतिसारादि॥",
  "after": "लिङ्गं श्वासगलग्रहकण्डूलालावमथ्वादि॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.31a",
  "kind": "metre",
  "line": "दूषीविषं तु शोणितदुष्ट्यारुःकिटिमकोठलिङ्गं च।",
  "before": "लिङ्गं श्वासगलग्रहकण्डूलालावमथ्वादि॥",
  "after": "विषमेकैकं दोषं संदूष्य हरत्यसूनेवम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.32a",
  "kind": "metre",
  "line": "क्षरति विषतेजसासृक् तत् खानि निरुध्य मारयति जन्तुम्।",
  "before": "विषमेकैकं दोषं संदूष्य हरत्यसूनेवम्॥",
  "after": "पीतं मृतस्य हृदि तिष्ठति दष्टविद्धयोर्दंशदेशे स्यात्॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.23.32b",
  "kind": "metre",
  "line": "पीतं मृतस्य हृदि तिष्ठति दष्टविद्धयोर्दंशदेशे स्यात्॥",
  "before": "क्षरति विषतेजसासृक् तत् खानि निरुध्य मारयति जन्तुम्।",
  "after": "नीलौष्ठदन्तशैथिल्यकेशपतनाङ्गभङ्गविक्षेपाः।",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.33a",
  "kind": "metre",
  "line": "नीलौष्ठदन्तशैथिल्यकेशपतनाङ्गभङ्गविक्षेपाः।",
  "before": "पीतं मृतस्य हृदि तिष्ठति दष्टविद्धयोर्दंशदेशे स्यात्॥",
  "after": "शिशिरैर्न लोमहर्षो नाभिहते दण्डराजी स्यात्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.34a",
  "kind": "metre",
  "line": "क्षतजं क्षताच्च नायात्येतानि भवन्ति मरणलिङ्गानि।",
  "before": "शिशिरैर्न लोमहर्षो नाभिहते दण्डराजी स्यात्॥",
  "after": "एभ्योऽन्यथा चिकित्स्यास्तेषां चोपक्रमाञ्छृणु मे॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.35a",
  "kind": "metre",
  "line": "मन्त्रारिष्टोत्कर्तननिष्पीडनचूषणाग्निपरिषेकाः।",
  "before": "एभ्योऽन्यथा चिकित्स्यास्तेषां चोपक्रमाञ्छृणु मे॥",
  "after": "अवगाहरक्तमोक्षणवमनविरेकोपधानानि॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.35b",
  "kind": "metre",
  "line": "अवगाहरक्तमोक्षणवमनविरेकोपधानानि॥",
  "before": "मन्त्रारिष्टोत्कर्तननिष्पीडनचूषणाग्निपरिषेकाः।",
  "after": "हृदयावरणाञ्जननस्यधूमलेहौषधप्रशमनानि।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.36a",
  "kind": "metre",
  "line": "हृदयावरणाञ्जननस्यधूमलेहौषधप्रशमनानि।",
  "before": "अवगाहरक्तमोक्षणवमनविरेकोपधानानि॥",
  "after": "प्रतिसारणं प्रतिविषं संज्ञासंस्थापनं लेपः॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.23.37a",
  "kind": "metre",
  "line": "मृतसञ्जीवनमेव च विंशतिरेते चतुर्भिरधिकाः।",
  "before": "प्रतिसारणं प्रतिविषं संज्ञासंस्थापनं लेपः॥",
  "after": "स्युरुपक्रमा यथा ये यत्र योज्याः शृणु तथा तान्॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.38a",
  "kind": "metre",
  "line": "दंशात्तु विषं दष्टस्याविसृतं वेणिकां भिषग्बद्ध्वा।",
  "before": "स्युरुपक्रमा यथा ये यत्र योज्याः शृणु तथा तान्॥",
  "after": "निष्पीडयेद्भृशं दंशमुद्धरेन्मर्मवर्जं वा॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.39a",
  "kind": "metre",
  "line": "तं दंशं वा चूषेन्मुखेन यवचूर्णपांशुपूर्णेन।",
  "before": "निष्पीडयेद्भृशं दंशमुद्धरेन्मर्मवर्जं वा॥",
  "after": "प्रच्छनशृङ्गजलौकाव्यधनैः स्राव्यं ततो रक्तम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.40a",
  "kind": "metre",
  "line": "रक्ते विषप्रदुष्टे दुष्येत् प्रकृतिस्ततस्त्यजेत् प्राणान्।",
  "before": "प्रच्छनशृङ्गजलौकाव्यधनैः स्राव्यं ततो रक्तम्॥",
  "after": "तस्मात् प्रघर्षणैरसृगवर्तमानं प्रवर्त्यं स्यात्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.42a",
  "kind": "metre",
  "line": "रक्तं हि विषाधानं वायुरिवाग्नेः प्रदेहसेकैस्तत्।",
  "before": "घर्षणमतिप्रवृत्ते वटादिभिः शीतलैर्लेपः॥",
  "after": "शीतैः स्कन्दति तस्मिन् स्कन्ने व्यपयाति विषवेगः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.43a",
  "kind": "metre",
  "line": "विषवेगान्मदमूर्च्छाविषादहृदयद्रवाः प्रवर्तन्ते।",
  "before": "शीतैः स्कन्दति तस्मिन् स्कन्ने व्यपयाति विषवेगः॥",
  "after": "शीतैर्निवर्तयेत्तान् वीज्यश्चालोमहर्षात् स्यात्॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.44a",
  "kind": "metre",
  "line": "तरुरिव मूलच्छेदाद्दंशच्छेदान्न वृद्धिमेति विषम्।",
  "before": "शीतैर्निवर्तयेत्तान् वीज्यश्चालोमहर्षात् स्यात्॥",
  "after": "आचूषणमानयनं जलस्य सेतुर्यथा तथारिष्टाः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.44b",
  "kind": "metre",
  "line": "आचूषणमानयनं जलस्य सेतुर्यथा तथारिष्टाः॥",
  "before": "तरुरिव मूलच्छेदाद्दंशच्छेदान्न वृद्धिमेति विषम्।",
  "after": "त्वङ्मांसगतं दाहो दहति विषं स्रावणं हरति रक्तात्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.45a",
  "kind": "metre",
  "line": "त्वङ्मांसगतं दाहो दहति विषं स्रावणं हरति रक्तात्।",
  "before": "आचूषणमानयनं जलस्य सेतुर्यथा तथारिष्टाः॥",
  "after": "पीतं वमनैः सद्यो हरेद्विरेकैर्द्वितीये तु॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.46a",
  "kind": "metre",
  "line": "आदौ हृदयं रक्ष्यं तस्यावरणं पिबेद्यथालाभम्।",
  "before": "पीतं वमनैः सद्यो हरेद्विरेकैर्द्वितीये तु॥",
  "after": "मधुसर्पिर्मज्जपयोगैरिकमथ गोमयरसं वा॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.46b",
  "kind": "metre",
  "line": "मधुसर्पिर्मज्जपयोगैरिकमथ गोमयरसं वा॥",
  "before": "आदौ हृदयं रक्ष्यं तस्यावरणं पिबेद्यथालाभम्।",
  "after": "इक्षुं सुपक्वमथवा काकं निष्पीड्य तद्रसं वरणम्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.47a",
  "kind": "metre",
  "line": "इक्षुं सुपक्वमथवा काकं निष्पीड्य तद्रसं वरणम्।",
  "before": "मधुसर्पिर्मज्जपयोगैरिकमथ गोमयरसं वा॥",
  "after": "छागादीनां वासृग्भस्म मृदं वा पिबेदाशु॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.48a",
  "kind": "metre",
  "line": "क्षारागदस्तृतीये शोफहरैर्लेखनं समध्वम्बु।",
  "before": "छागादीनां वासृग्भस्म मृदं वा पिबेदाशु॥",
  "after": "गोमयरसश्चतुर्थे वेगे सकपित्थमधुसर्पिः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.48b",
  "kind": "metre",
  "line": "गोमयरसश्चतुर्थे वेगे सकपित्थमधुसर्पिः॥",
  "before": "क्षारागदस्तृतीये शोफहरैर्लेखनं समध्वम्बु।",
  "after": "काकाण्डशिरीषाभ्यां स्वरसेनाश्च्योतनाञ्जने नस्यम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.49a",
  "kind": "metre",
  "line": "काकाण्डशिरीषाभ्यां स्वरसेनाश्च्योतनाञ्जने नस्यम्।",
  "before": "गोमयरसश्चतुर्थे वेगे सकपित्थमधुसर्पिः॥",
  "after": "स्यात्पञ्चमेऽथ षष्ठे संज्ञायाः स्थापनं कार्यम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.50a",
  "kind": "metre",
  "line": "गोपित्तयुता रजनी मञ्जिष्ठामरिचपिप्पलीपानम्।",
  "before": "स्यात्पञ्चमेऽथ षष्ठे संज्ञायाः स्थापनं कार्यम्॥",
  "after": "विषपानं दष्टानां विषपीते दंशनं चान्ते॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.51a",
  "kind": "metre",
  "line": "शिखिपित्तार्धयुतं स्यात् पलाशबीजमगदो मृतेषु वरः।",
  "before": "विषपानं दष्टानां विषपीते दंशनं चान्ते॥",
  "after": "वार्ताकुफाणितागारधूमगोपित्तनिम्बं वा॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.23.52b",
  "kind": "metre",
  "line": "शस्तामृतेन तुल्या शिरीषपुष्पकाकाण्डकरसैर्वा॥",
  "before": "गोपित्तयुतैर्गुटिकाः सुरसाग्रन्थिद्विरजनीमधुककुष्ठैः।",
  "after": "काकाण्डसुरसगवाक्षीपुनर्नवावायसीशिरीषफलैः।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.53a",
  "kind": "metre",
  "line": "काकाण्डसुरसगवाक्षीपुनर्नवावायसीशिरीषफलैः।",
  "before": "शस्तामृतेन तुल्या शिरीषपुष्पकाकाण्डकरसैर्वा॥",
  "after": "उद्बन्धविषजलमृते लेपौपधिनस्यपानानि॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.23.53b",
  "kind": "metre",
  "line": "उद्बन्धविषजलमृते लेपौपधिनस्यपानानि॥",
  "before": "काकाण्डसुरसगवाक्षीपुनर्नवावायसीशिरीषफलैः।",
  "after": "स्पृक्काप्लवस्थौणेयकांक्षीशैलेयरोचनातगरम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.54a",
  "kind": "metre",
  "line": "स्पृक्काप्लवस्थौणेयकांक्षीशैलेयरोचनातगरम्।",
  "before": "उद्बन्धविषजलमृते लेपौपधिनस्यपानानि॥",
  "after": "ध्यामककुङ्कुममांसीसुरसाग्रैलालकुष्ठघ्नम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.55a",
  "kind": "metre",
  "line": "बृहती शिरीषपुष्पं श्रीवेष्टकपद्मचारटिविशालाः।",
  "before": "ध्यामककुङ्कुममांसीसुरसाग्रैलालकुष्ठघ्नम्॥",
  "after": "सुरदारुपद्मकेशरसावरकमनःशिलाकौन्त्यः॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.55b",
  "kind": "metre",
  "line": "सुरदारुपद्मकेशरसावरकमनःशिलाकौन्त्यः॥",
  "before": "बृहती शिरीषपुष्पं श्रीवेष्टकपद्मचारटिविशालाः।",
  "after": "जात्यर्कपुष्परसरजनीद्वयहिङ्गुपिप्पलीलाक्षाः।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.56a",
  "kind": "metre",
  "line": "जात्यर्कपुष्परसरजनीद्वयहिङ्गुपिप्पलीलाक्षाः।",
  "before": "सुरदारुपद्मकेशरसावरकमनःशिलाकौन्त्यः॥",
  "after": "जलमुद्गपर्णिचन्दनमधुकमदनसिन्धुवाराश्च॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.56b",
  "kind": "metre",
  "line": "जलमुद्गपर्णिचन्दनमधुकमदनसिन्धुवाराश्च॥",
  "before": "जात्यर्कपुष्परसरजनीद्वयहिङ्गुपिप्पलीलाक्षाः।",
  "after": "शम्पाकलोध्रमयूरकगन्धफलानाकुलीविडङ्गाश्च।",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.57a",
  "kind": "metre",
  "line": "शम्पाकलोध्रमयूरकगन्धफलानाकुलीविडङ्गाश्च।",
  "before": "जलमुद्गपर्णिचन्दनमधुकमदनसिन्धुवाराश्च॥",
  "after": "पुष्ये संहृत्य समं पिष्ट्वा गुटिका विघेयाः स्युः॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.58a",
  "kind": "metre",
  "line": "सर्वविषघ्नो जयकृद्विषमृतस्ंजीवनो ज्वरनिहन्ता।",
  "before": "पुष्ये संहृत्य समं पिष्ट्वा गुटिका विघेयाः स्युः॥",
  "after": "घ्रेयविलेपनधारणधूमग्रहणैर्गृहस्थश्च॥",
