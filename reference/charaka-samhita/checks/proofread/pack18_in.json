 },
 {
  "id": "06.23.66a",
  "kind": "metre",
  "line": "चर्मकषायाः कल्कं बिल्वसमं मूर्ध्नि काकपदमस्य।",
  "before": "मृत इव श्वसेन्मर्त्यः स्यादसाध्यलिङ्गैर्विहीनश्च॥",
  "after": "कृत्वा दद्यात्कटभीकटुकट्फलप्रधमनं च॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.68a",
  "kind": "metre",
  "line": "नासाक्षिकर्णजिह्वाकण्ठनिरोधेषु कर्म नस्तः स्यात्।",
  "before": "दद्यात् काकपदे तस्मिंस्ततः संक्रमते विषम्॥",
  "after": "वार्ताकुबीजपूरज्योतिष्मत्यादिभिः पिष्टैः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.69a",
  "kind": "metre",
  "line": "अञ्जनमक्ष्युपरोधे कर्तव्यं बस्तमूत्रपिष्टैस्तु।",
