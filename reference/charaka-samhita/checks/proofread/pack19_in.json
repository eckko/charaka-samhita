[
 {
  "id": "06.23.76a",
  "kind": "metre",
  "line": "वृद्धौ किटिमे कुष्ठे श्वित्रऋविचर्चिकादिषु लेपः।",
  "before": "मूढे गर्भे दुष्टे ललाटलेपः प्रतिश्याये॥",
  "after": "गज इव तरून् विषगदान्निहन्त्यगदगन्धहस्त्येषः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.76b",
  "kind": "metre",
  "line": "गज इव तरून् विषगदान्निहन्त्यगदगन्धहस्त्येषः॥",
  "before": "वृद्धौ किटिमे कुष्ठे श्वित्रऋविचर्चिकादिषु लेपः।",
  "after": "इति गन्धहस्तीनामागदः।",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.77b",
  "kind": "metre",
  "line": "त्वङ्नलदोत्पलबालकहरेणुकोशीरवन्यनखाः॥",
  "before": "पत्रागुरुमुस्तैला निर्यासाः पञ्च चन्दनं स्पृक्का।",
  "after": "सुरदारुकनककुङ्कुमध्यामककुष्ठप्रियङ्गवस्तगरम्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.79a",
  "kind": "metre",
  "line": "श्वेतकटभीकरञ्जौ रक्षोघ्नी सिन्धुवारिका रजनी।",
  "before": "पञ्चाङ्गानि शुरीषाद्व्योषालमनःशिलाजाज्यः॥",
  "after": "सुरसाञ्जनगौरिकमञ्जिष्ठानिम्बनिर्यासाः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.80a",
  "kind": "metre",
  "line": "वंशत्वगश्वगन्धाहिङ्गुदधित्थाम्लवेतसं लाक्षा।",
  "before": "सुरसाञ्जनगौरिकमञ्जिष्ठानिम्बनिर्यासाः॥",
  "after": "मधुमधुकसोमराजीवचारुहारोचनातगरम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.80b",
  "kind": "metre",
  "line": "मधुमधुकसोमराजीवचारुहारोचनातगरम्॥",
  "before": "वंशत्वगश्वगन्धाहिङ्गुदधित्थाम्लवेतसं लाक्षा।",
  "after": "अगदोऽयं वैश्रवणायाख्यातस्त्र्यम्बकेण षष्ट्यङ्गः।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.81a",
  "kind": "metre",
  "line": "अगदोऽयं वैश्रवणायाख्यातस्त्र्यम्बकेण षष्ट्यङ्गः।",
  "before": "मधुमधुकसोमराजीवचारुहारोचनातगरम्॥",
  "after": "अप्रतिहतप्रभावः ख्यातो महागन्धहस्तीति॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.82a",
  "kind": "metre",
  "line": "पित्तेन गवां पेष्यो गुटिकाः कार्यास्तु पुष्ययोगेन।",
  "before": "अप्रतिहतप्रभावः ख्यातो महागन्धहस्तीति॥",
  "after": "पानाञ्जनप्रलेपैः प्रसाधयेत् सर्वकर्माणि॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.83a",
  "kind": "metre",
  "line": "पिल्लं कण्डूं तिमिरं रात्र्यान्ध्यं काचमर्बुदं पटलम्।",
  "before": "पानाञ्जनप्रलेपैः प्रसाधयेत् सर्वकर्माणि॥",
  "after": "हन्ति सततप्रयोगाद्धितमितपथ्याशिनां पुंसाम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.83b",
  "kind": "metre",
  "line": "हन्ति सततप्रयोगाद्धितमितपथ्याशिनां पुंसाम्॥",
  "before": "पिल्लं कण्डूं तिमिरं रात्र्यान्ध्यं काचमर्बुदं पटलम्।",
  "after": "विषमज्वरानजीर्णान्दद्रुं कण्डूं विसूचिकां पामाम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.84a",
  "kind": "metre",
  "line": "विषमज्वरानजीर्णान्दद्रुं कण्डूं विसूचिकां पामाम्।",
  "before": "हन्ति सततप्रयोगाद्धितमितपथ्याशिनां पुंसाम्॥",
  "after": "विषमूषिकलूतानां सर्वेषां पन्नगानां च।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.84c",
  "kind": "metre",
  "line": "आशु विषं नाशयति समूलजमथ कन्दजं सर्वम्॥",
  "before": "विषमूषिकलूतानां सर्वेषां पन्नगानां च।",
  "after": "एतेन लिप्तगात्रः सर्पान् गृह्णाति भक्षयेच्च विषम्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.85a",
  "kind": "metre",
  "line": "एतेन लिप्तगात्रः सर्पान् गृह्णाति भक्षयेच्च विषम्।",
  "before": "आशु विषं नाशयति समूलजमथ कन्दजं सर्वम्॥",
  "after": "कालपरीतोऽपि नरो जीवति नित्यं निरातङ्कः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.86b",
  "kind": "metre",
  "line": "मूर्च्छार्तिषु च ललाटे प्रलेपनमाहुः प्रधानतमम्॥",
  "before": "आनद्धे गुदलेपो योनौ लेपश्च मूढगर्भाणाम्।",
  "after": "भेरीमृदङ्गपटहाञ्छत्राण्यमुना तथा ध्वजपताकाः।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.87a",
  "kind": "metre",
  "line": "भेरीमृदङ्गपटहाञ्छत्राण्यमुना तथा ध्वजपताकाः।",
  "before": "मूर्च्छार्तिषु च ललाटे प्रलेपनमाहुः प्रधानतमम्॥",
  "after": "लिप्त्वाहिविषनिरस्त्यै पध्वनयेद्दर्शयेन्मतिमान्॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.87b",
  "kind": "metre",
  "line": "लिप्त्वाहिविषनिरस्त्यै पध्वनयेद्दर्शयेन्मतिमान्॥",
  "before": "भेरीमृदङ्गपटहाञ्छत्राण्यमुना तथा ध्वजपताकाः।",
  "after": "यत्र च सन्निहितोऽयं न तत्र बालग्रहा न रक्षांसि।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.88a",
  "kind": "metre",
  "line": "यत्र च सन्निहितोऽयं न तत्र बालग्रहा न रक्षांसि।",
  "before": "लिप्त्वाहिविषनिरस्त्यै पध्वनयेद्दर्शयेन्मतिमान्॥",
  "after": "न च कार्मणवेताला वहन्ति नाथर्वणा मन्त्राः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.89a",
  "kind": "metre",
  "line": "सर्वग्रहा न तत्र प्रभवन्ति न चाग्निशस्त्रनृपचौराः।",
  "before": "न च कार्मणवेताला वहन्ति नाथर्वणा मन्त्राः॥",
  "after": "लक्ष्मीश्च तत्र भजते यत्र महागन्धहस्त्यस्ति॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.94b",
  "kind": "metre",
  "line": "हिलिमिलिसंस्पृष्टे रक्ष सर्वभेषजोत्तमे स्वाहा॥",
  "before": "अनेन सत्यवाक्येन सिध्यतामगदो ह्ययम्।",
  "after": "इति महागन्धहस्तीनामागदः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.95a",
  "kind": "metre",
  "line": "ऋषभकजीवकभार्गीमधुकोत्पलधान्यकेशराजाज्यः।",
  "before": "इति महागन्धहस्तीनामागदः।",
  "after": "ससितगिरिकोलमध्याः पेयाः श्वासज्वरादिहराः॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.23.95b",
  "kind": "metre",
  "line": "ससितगिरिकोलमध्याः पेयाः श्वासज्वरादिहराः॥",
  "before": "ऋषभकजीवकभार्गीमधुकोत्पलधान्यकेशराजाज्यः।",
  "after": "हिङ्गु च कृष्णायुक्तं कपित्थरसयुक्तमग्र्यलवणं च।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.96a",
  "kind": "metre",
  "line": "हिङ्गु च कृष्णायुक्तं कपित्थरसयुक्तमग्र्यलवणं च।",
  "before": "ससितगिरिकोलमध्याः पेयाः श्वासज्वरादिहराः॥",
  "after": "समधुसितौ पातव्यौ ज्वरहिक्काश्वासकासघ्नौ॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.98a",
  "kind": "metre",
  "line": "शिखिबर्हिबलाकास्थीनि सर्षपाश्चन्दनं च घृतयुक्तम्।",
  "before": "बृहतीद्वयाढकीपत्रधूमवर्तिस्तु हिक्काघ्नी॥",
  "after": "धूमो गृहशयनासनवस्त्रादिषु शस्यते विषनुत्॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.98b",
  "kind": "metre",
  "line": "धूमो गृहशयनासनवस्त्रादिषु शस्यते विषनुत्॥",
  "before": "शिखिबर्हिबलाकास्थीनि सर्षपाश्चन्दनं च घृतयुक्तम्।",
  "after": "घृतयुक्ते नतकुष्ठे भुजगपतिशिरः शिरीषपुष्पं च।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.99a",
  "kind": "metre",
  "line": "घृतयुक्ते नतकुष्ठे भुजगपतिशिरः शिरीषपुष्पं च।",
  "before": "धूमो गृहशयनासनवस्त्रादिषु शस्यते विषनुत्॥",
  "after": "धूमागदः स्मृतोऽयं सर्वविषघ्नः श्वयथुहृच्च॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.23.100b",
  "kind": "metre",
  "line": "श्वेता च धूम उरगाखुकीटवस्त्रक्रिमिनुदग्र्यः॥",
  "before": "जतुसेव्यपत्रगुग्गुलुभल्लातकककुभपुष्पसर्जरसाः।",
  "after": "तरुणपलाशक्षारं स्रुतं पचेच्चूर्णितैः सह समांशैः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.101a",
  "kind": "metre",
  "line": "तरुणपलाशक्षारं स्रुतं पचेच्चूर्णितैः सह समांशैः।",
  "before": "श्वेता च धूम उरगाखुकीटवस्त्रक्रिमिनुदग्र्यः॥",
  "after": "लोहितमृद्रजनीद्वयशुक्लसुरसमञ्जरीमधुकैः॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.101b",
  "kind": "metre",
  "line": "लोहितमृद्रजनीद्वयशुक्लसुरसमञ्जरीमधुकैः॥",
  "before": "तरुणपलाशक्षारं स्रुतं पचेच्चूर्णितैः सह समांशैः।",
  "after": "लाक्षासैन्धवमांसीहरेणुहिङ्गुद्विसारिवाकुष्ठैः।",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.102a",
  "kind": "metre",
  "line": "लाक्षासैन्धवमांसीहरेणुहिङ्गुद्विसारिवाकुष्ठैः।",
  "before": "लोहितमृद्रजनीद्वयशुक्लसुरसमञ्जरीमधुकैः॥",
  "after": "सव्योषैर्बाह्लीकैर्दर्वीविलेपनं घट्टयेद्यावत्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.103a",
  "kind": "metre",
  "line": "सर्वविषशोथगुल्मत्वग्दोषार्शोभगन्दरप्लीह्नः।",
  "before": "सव्योषैर्बाह्लीकैर्दर्वीविलेपनं घट्टयेद्यावत्॥",
  "after": "शोथापस्मारक्रिमिभूतस्वरोभेदपाण्डुगदान्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.104c",
  "kind": "metre",
  "line": "इति क्षारागदः।",
  "before": "गुटिकाश्छायाशुष्काः कोलसमास्ताः समुपयुक्ताः॥",
  "after": "विषपीतदष्टविद्धेष्वेतद्दिग्धे च चाच्यमुद्दिष्टम्।",
  "note": "6 aksharas"
 },
 {
  "id": "06.23.105a",
  "kind": "metre",
  "line": "विषपीतदष्टविद्धेष्वेतद्दिग्धे च चाच्यमुद्दिष्टम्।",
  "before": "इति क्षारागदः।",
  "after": "सामान्यतः, पृथक्त्वान्निर्देशमतः शृणु यथावत्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.106a",
  "kind": "metre",
  "line": "रिपुयुक्तेभ्यो नृभ्यः स्वेभ्यः स्त्रीभ्योऽथवा भयं नृपतेः।",
  "before": "सामान्यतः, पृथक्त्वान्निर्देशमतः शृणु यथावत्॥",
  "after": "आहारविहारगतं तस्मात् प्रेष्यान् परीक्षेत॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.107a",
  "kind": "metre",
  "line": "अत्यर्थशाङ्कितः स्याद्बहुवागथवाल्पवाग्विगतलक्ष्मीः।",
  "before": "आहारविहारगतं तस्मात् प्रेष्यान् परीक्षेत॥",
  "after": "प्राप्तः प्रकृतिविकारं विषप्रदाता नरो ज्ञेयः॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.108a",
  "kind": "metre",
  "line": "दृष्ट्वैवं न तु सहसा भोज्यं कुर्यात्तदन्नमग्नौ तु।",
  "before": "प्राप्तः प्रकृतिविकारं विषप्रदाता नरो ज्ञेयः॥",
  "after": "सविषं हि प्राप्यान्नं बहून्विकारान् भजत्यग्निः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.109a",
  "kind": "metre",
  "line": "शिखिबर्हविचित्रार्चिस्तीक्ष्णाक्षमरूक्षकुणपधूमश्च।",
  "before": "सविषं हि प्राप्यान्नं बहून्विकारान् भजत्यग्निः॥",
  "after": "स्फुटति च सशब्दमेकावर्तो विहतार्चिरपि च स्यात्॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.109b",
  "kind": "metre",
  "line": "स्फुटति च सशब्दमेकावर्तो विहतार्चिरपि च स्यात्॥",
  "before": "शिखिबर्हविचित्रार्चिस्तीक्ष्णाक्षमरूक्षकुणपधूमश्च।",
  "after": "पात्रस्थं च विवर्णं भोज्यं स्यान्मक्षिकांश्च मारयति।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.110a",
  "kind": "metre",
  "line": "पात्रस्थं च विवर्णं भोज्यं स्यान्मक्षिकांश्च मारयति।",
  "before": "स्फुटति च सशब्दमेकावर्तो विहतार्चिरपि च स्यात्॥",
