  "kind": "metre",
  "line": "मध्याम्बु वाम्बु कोष्णं बलवांस्तृषितः समुल्लिखेत् पीत्वा।",
  "before": "प्रपिबेद्गुरुणा तृषितो भुक्तेन तदुद्धरेद्भुक्तम्॥",
  "after": "मागधिकाविशदमुखः सशर्करं वा पिबेन्मन्थम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.22.53b",
  "kind": "metre",
  "line": "मागधिकाविशदमुखः सशर्करं वा पिबेन्मन्थम्॥",
  "before": "मध्याम्बु वाम्बु कोष्णं बलवांस्तृषितः समुल्लिखेत् पीत्वा।",
  "after": "बलवांस्तु तालुशोषे पिबेद्घृतं तृष्यमद्याच्च।",
  "note": "18 aksharas"
 },
 {
  "id": "06.22.55a",
  "kind": "metre",
  "line": "अतिरूक्षदुर्बलानां तर्षं शमयेन्नृणामिहाशु पयः।",
  "before": "सर्पिर्भृष्टं क्षीरं मांसरसांश्चाबलः स्निग्धान्॥",
  "after": "छागो वा घृतभृष्टः शीतो मधुरो रसो हृद्यः॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.22.57a",
  "kind": "metre",
  "line": "तृट्दाहमूर्च्छाभ्रमक्लममदात्ययास्रविषपित्ते।",
  "before": "तर्षं मूर्च्छाभिहतस्य रक्तपित्तापहैर्हन्यात्॥",
  "after": "शस्तं स्वभावशीतं, शृतशीतं सन्निपातेऽम्भः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.22.58a",
  "kind": "metre",
  "line": "हिक्काश्वासनवज्वरपीनसघृतपीतपार्श्वगलरोगे।",
  "before": "शस्तं स्वभावशीतं, शृतशीतं सन्निपातेऽम्भः॥",
  "after": "कफवातकृते स्त्याने सद्यःशुद्धे च हितमुष्णम्॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.22.59a",
  "kind": "metre",
  "line": "पाण्डूदरपीनसमेहगुल्ममन्दानलातिसारेषु।",
  "before": "कफवातकृते स्त्याने सद्यःशुद्धे च हितमुष्णम्॥",
  "after": "प्लीह्नि च तोयं न हितं काममसह्ये पिबेदल्पम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.22.60b",
  "kind": "metre",
  "line": "न लभेत स चेन्मरणमाश्वेवाप्नुपाद्दीर्घरोगं वा॥",
  "before": "पूर्वमयातुरः सन् दीनस्तृष्णार्दितो जलं काङ्क्षन्।",
  "after": "तस्माद्धान्याम्बु पिबेत्तृष्यन् रोगी सशर्कराक्षौद्रम्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.22.61b",
  "kind": "metre",
  "line": "यद्वा तस्यान्यत्स्यात् सात्म्यं रोगस्य तच्चेष्टम्॥",
  "before": "तस्माद्धान्याम्बु पिबेत्तृष्यन् रोगी सशर्कराक्षौद्रम्।",
  "after": "तस्यां विनिवृत्तायां तज्जन्य उपद्रवः सुखं जेतुम्।",
  "note": "14 aksharas"
 },
 {
  "id": "06.22.62a",
  "kind": "metre",
  "line": "तस्यां विनिवृत्तायां तज्जन्य उपद्रवः सुखं जेतुम्।",
  "before": "यद्वा तस्यान्यत्स्यात् सात्म्यं रोगस्य तच्चेष्टम्॥",
  "after": "तस्मात्तृष्णां पूर्वं जयेद्बहुभ्योऽपि रोगेभ्यः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.22.63a",
  "kind": "metre",
  "line": "तत्र श्लोकः---",
  "before": "तस्मात्तृष्णां पूर्वं जयेद्बहुभ्योऽपि रोगेभ्यः॥",
  "after": "हेतू यथाग्निपवनौ कुरुतः सोपद्रवां च पञ्चानाम्।",
  "note": "4 aksharas"
 },
 {
  "id": "06.22.63b",
  "kind": "metre",
  "line": "हेतू यथाग्निपवनौ कुरुतः सोपद्रवां च पञ्चानाम्।",
  "before": "तत्र श्लोकः---",
  "after": "तृष्णानां पृथगाकृतिरसाध्यता साधनं चोक्तम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.1",
  "kind": "metre",
  "line": "अथातो विषचिकित्सितं व्याख्यास्यामः॥",
  "before": "इत्यग्निवेशकृते तन्त्रे चरकप्रतिसंस्कृतेऽप्राप्ते दृढबलसंपूरिते चिकित्सास्थाने तृष्णारोगचिकित्सितं नाम द्वाविंशोऽध्यायः॥",
  "after": "इति ह स्माह भगवानात्रेयः॥",
  "note": "13 aksharas"
 },
 {
  "id": "06.23.3a",
  "kind": "metre",
  "line": "प्रागुत्पत्तिं गुणान् योनिं वेगां(अनुनासिक)ल्लिङ्गान्युपक्रमान्।",
  "before": "इति ह स्माह भगवानात्रेयः॥",
  "after": "चिषस्य ब्रुवतः सम्यगग्निवेश निबोध मे॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.23.18a",
  "kind": "metre",
  "line": "तृण्मोहदन्तहर्षप्रसेकवमथुक्लमा भवन्त्याद्ये।",
  "before": "तस्माद्दंष्ट्राविषं मौलं हन्ति मौलं च दंष्ट्रजम्॥",
  "after": "वेगे रसप्रदोषादसृक्प्रदोषाद्द्वितीये तु॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.19a",
  "kind": "metre",
  "line": "वैवर्ण्यभ्रमवेपथुमूर्च्छाजृम्भाङ्गचिमिचिमातमकाः।",
  "before": "वेगे रसप्रदोषादसृक्प्रदोषाद्द्वितीये तु॥",
  "after": "दुष्टपिशितात्तृतीये मण्डलकण्डूश्वयथुकोठाः॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.19b",
  "kind": "metre",
  "line": "दुष्टपिशितात्तृतीये मण्डलकण्डूश्वयथुकोठाः॥",
  "before": "वैवर्ण्यभ्रमवेपथुमूर्च्छाजृम्भाङ्गचिमिचिमातमकाः।",
  "after": "वातादिजाश्चतुर्थे दाहच्छर्द्यङ्गशूलमूर्च्छाद्याः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.21a",
  "kind": "metre",
  "line": "षष्ठे हिक्का, भङ्गः स्कन्धस्य तु सप्तमेऽष्टमे मरणम्।",
  "before": "नीलादीनां तमसश्च दर्शनं पञ्चमे वेगे॥",
  "after": "नॄणां, चतुष्पदां स्याच्चतुर्विधः, पक्षिणां त्रिविधः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.22a",
  "kind": "metre",
  "line": "सीदत्याद्ये भ्रमति च, चतुष्पदो वेपते, ततः शून्यः।",
  "before": "नॄणां, चतुष्पदां स्याच्चतुर्विधः, पक्षिणां त्रिविधः॥",
  "after": "मन्दाहारो म्रियते श्वासेन हि चतुर्थवेगे तु॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.23a",
  "kind": "metre",
  "line": "ध्यायति विहगः प्रथमे वेगे, प्रभ्राम्यति द्वितीये तु।",
  "before": "मन्दाहारो म्रियते श्वासेन हि चतुर्थवेगे तु॥",
  "after": "स्रस्ताङ्गश्च तृतीये विषवेगे याति पञ्चत्वम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.24a",
  "kind": "metre",
  "line": "लघु रूक्षमाशु विशदं व्यवायि तीक्ष्णं विकासि सूक्ष्मं च।",
  "before": "स्रस्ताङ्गश्च तृतीये विषवेगे याति पञ्चत्वम्॥",
  "after": "उष्णमनिर्देश्यरसं दशगुणमुक्तं विषं तज्ज्ञैः॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.23.24b",
  "kind": "metre",
  "line": "उष्णमनिर्देश्यरसं दशगुणमुक्तं विषं तज्ज्ञैः॥",
  "before": "लघु रूक्षमाशु विशदं व्यवायि तीक्ष्णं विकासि सूक्ष्मं च।",
  "after": "रौक्ष्याद्वातमशैत्यात्पित्तं सौक्ष्म्यादसृक् प्रकोपयति।",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.25a",
  "kind": "metre",
  "line": "रौक्ष्याद्वातमशैत्यात्पित्तं सौक्ष्म्यादसृक् प्रकोपयति।",
  "before": "उष्णमनिर्देश्यरसं दशगुणमुक्तं विषं तज्ज्ञैः॥",
  "after": "कफमव्यक्तरसत्वादन्नरसांश्चानुवर्तते शीघ्रम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.23.25b",
  "kind": "metre",
  "line": "कफमव्यक्तरसत्वादन्नरसांश्चानुवर्तते शीघ्रम्॥",
  "before": "रौक्ष्याद्वातमशैत्यात्पित्तं सौक्ष्म्यादसृक् प्रकोपयति।",
  "after": "शीघ्रं व्यवायिभावादाशु व्याप्नोति केवलं देहम्।",
  "note": "19 aksharas"
 },
 {
  "id": "06.23.26b",
  "kind": "metre",
  "line": "तीक्ष्णत्वान्मर्मघ्नं प्राणघ्नं तद्विकासित्वात्॥",
  "before": "शीघ्रं व्यवायिभावादाशु व्याप्नोति केवलं देहम्।",
  "after": "दुरुपक्रमं लघुत्वाद्वैशद्यात् स्यादसक्तगतिदोषम्।",
  "note": "14 aksharas"
 },
 {
  "id": "06.23.27a",
  "kind": "metre",
  "line": "दुरुपक्रमं लघुत्वाद्वैशद्यात् स्यादसक्तगतिदोषम्।",
  "before": "तीक्ष्णत्वान्मर्मघ्नं प्राणघ्नं तद्विकासित्वात्॥",
  "after": "दोषस्थानप्रकृतीः प्राप्यान्यतमं ह्युदीरयति॥",
  "note": "19 aksharas"
 }
]