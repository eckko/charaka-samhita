[
 {
  "id": "06.07.88b",
  "kind": "metre",
  "line": "गोधारसः सलवणो दारु च मूत्रं च मण्डलनुत्॥",
  "before": "त्रपु सीसमयश्चूर्णं मण्डलनुत् फल्गुचित्रकौ बृहती।",
  "after": "कदलीपलाशपाटलिनिचुलक्षाराम्भसा प्रसन्नेन।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.89a",
  "kind": "metre",
  "line": "कदलीपलाशपाटलिनिचुलक्षाराम्भसा प्रसन्नेन।",
  "before": "गोधारसः सलवणो दारु च मूत्रं च मण्डलनुत्॥",
  "after": "मांसेषु तोयकार्यं कार्यं पिष्टे च किण्वे च॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.90a",
  "kind": "metre",
  "line": "तैर्मेदकः सुजातः किण्वैर्जनितं प्रलेपनं शस्तम्।",
  "before": "मांसेषु तोयकार्यं कार्यं पिष्टे च किण्वे च॥",
  "after": "मण्डलकुष्ठविनाशनमातपसंस्थं कृमिघ्नं च॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.90b",
  "kind": "metre",
  "line": "मण्डलकुष्ठविनाशनमातपसंस्थं कृमिघ्नं च॥",
  "before": "तैर्मेदकः सुजातः किण्वैर्जनितं प्रलेपनं शस्तम्।",
  "after": "मुस्तं मदनं त्रिफला करञ्ज आरग्वधकलिङ्गयवाः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.91a",
  "kind": "metre",
  "line": "मुस्तं मदनं त्रिफला करञ्ज आरग्वधकलिङ्गयवाः।",
  "before": "मण्डलकुष्ठविनाशनमातपसंस्थं कृमिघ्नं च॥",
  "after": "दार्वी ससप्तपर्णा स्नानं सिद्धार्थकं नाम॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.92a",
  "kind": "metre",
  "line": "एष कषायो वमनं विरेचनं वर्णकस्तथोद्घर्षः।",
  "before": "दार्वी ससप्तपर्णा स्नानं सिद्धार्थकं नाम॥",
  "after": "त्वग्दोषकुष्ठशोफप्रबाधनः पाण्डुरोगघ्नः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.93a",
  "kind": "metre",
  "line": "कुष्ठं करञ्जबीजान्येडगजः कुष्ठसूदनो लेपः।",
  "before": "त्वग्दोषकुष्ठशोफप्रबाधनः पाण्डुरोगघ्नः॥",
  "after": "प्रपुन्नाडबीजसैन्धवरसाञ्जनकपित्थलोध्राश्च॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.93b",
  "kind": "metre",
  "line": "प्रपुन्नाडबीजसैन्धवरसाञ्जनकपित्थलोध्राश्च॥",
  "before": "कुष्ठं करञ्जबीजान्येडगजः कुष्ठसूदनो लेपः।",
  "after": "श्वेतकरवीरमूलं कुटजकरञ्जयोः फलं त्वचो दार्व्याः।",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.94a",
  "kind": "metre",
  "line": "श्वेतकरवीरमूलं कुटजकरञ्जयोः फलं त्वचो दार्व्याः।",
  "before": "प्रपुन्नाडबीजसैन्धवरसाञ्जनकपित्थलोध्राश्च॥",
  "after": "सुमनःप्रवालयुक्तो लेपः कुष्ठापहः सिद्धः॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.07.95a",
  "kind": "metre",
  "line": "लोध्रस्य धातकीनां वत्सकबीजस्य नक्तमालस्य।",
  "before": "सुमनःप्रवालयुक्तो लेपः कुष्ठापहः सिद्धः॥",
  "after": "कल्कश्च मालतीनां कुष्ठेषून्मर्दनालेपौ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.96c",
  "kind": "metre",
  "line": "इति लेपाः।",
  "before": "पिष्टा च काकमाची चतुर्विधः कुष्ठनुल्लेपः॥",
  "after": "दार्व्या रसाञ्जनस्य च निम्बपटोलस्य खदिरसारस्य।",
  "note": "4 aksharas"
 },
 {
  "id": "06.07.97a",
  "kind": "metre",
  "line": "दार्व्या रसाञ्जनस्य च निम्बपटोलस्य खदिरसारस्य।",
  "before": "इति लेपाः।",
  "after": "आरग्वधवृक्षकयोस्त्रिफलायाः सप्तपर्णस्य॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.98a",
  "kind": "metre",
  "line": "इति षट् कषाययोगाः कुष्ठघ्नाः सप्तमश्च तिनिशस्य।",
  "before": "आरग्वधवृक्षकयोस्त्रिफलायाः सप्तपर्णस्य॥",
  "after": "स्नाने पाने च हितास्तथाष्टमश्चाश्वमारस्य॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.99a",
  "kind": "metre",
  "line": "आलेपनं प्रघर्षणमवचूर्णनमेत एव च कषायाः।",
  "before": "स्नाने पाने च हितास्तथाष्टमश्चाश्वमारस्य॥",
  "after": "तैलघृतपाकयोगे चेष्यन्ते कुष्ठशान्त्यर्थम्॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.07.100a",
  "kind": "metre",
  "line": "त्रिफला निम्बपटोलं मञ्जिष्ठा रोहिणी वचा रजनी।",
  "before": "तैलघृतपाकयोगे चेष्यन्ते कुष्ठशान्त्यर्थम्॥",
  "after": "एष कषायोऽभ्यस्तो निहन्ति कफपित्तजं कुष्ठम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.101a",
  "kind": "metre",
  "line": "एतैरेव च सर्पिः सिद्धं वातोल्बणं जयति कुष्ठम्।",
  "before": "एष कषायोऽभ्यस्तो निहन्ति कफपित्तजं कुष्ठम्॥",
  "after": "एष च कल्पो दिष्टः खदिरासनदारुनिम्बानाम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.102a",
  "kind": "metre",
  "line": "कुष्ठार्कतुत्थकट्फलमूलकबीजानि रोहिणी कटुका।",
  "before": "एष च कल्पो दिष्टः खदिरासनदारुनिम्बानाम्॥",
  "after": "कुटजफलोत्पलमुस्तं बृहतीकरवीरकासीसम्॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.102b",
  "kind": "metre",
  "line": "कुटजफलोत्पलमुस्तं बृहतीकरवीरकासीसम्॥",
  "before": "कुष्ठार्कतुत्थकट्फलमूलकबीजानि रोहिणी कटुका।",
  "after": "एडगजनिम्बपाठा दुरालभा चित्रको विडङ्गश्च।",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.103a",
  "kind": "metre",
  "line": "एडगजनिम्बपाठा दुरालभा चित्रको विडङ्गश्च।",
  "before": "कुटजफलोत्पलमुस्तं बृहतीकरवीरकासीसम्॥",
  "after": "तिक्तालाबुकबीजं कम्पिल्लकसर्षपौ वचा दार्वी॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.103b",
  "kind": "metre",
  "line": "तिक्तालाबुकबीजं कम्पिल्लकसर्षपौ वचा दार्वी॥",
  "before": "एडगजनिम्बपाठा दुरालभा चित्रको विडङ्गश्च।",
  "after": "एतैस्तैलं सिद्धं कुष्ठघ्नं योग एष चालेपः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.104b",
  "kind": "metre",
  "line": "उद्वर्तनं प्रघर्षणमवचूर्णनमेष एवेष्टः॥",
  "before": "एतैस्तैलं सिद्धं कुष्ठघ्नं योग एष चालेपः।",
  "after": "श्वेतकरवीरकरसो गोमूत्रं चित्रको विडङ्गश्च।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.105a",
  "kind": "metre",
  "line": "श्वेतकरवीरकरसो गोमूत्रं चित्रको विडङ्गश्च।",
  "before": "उद्वर्तनं प्रघर्षणमवचूर्णनमेष एवेष्टः॥",
  "after": "कुष्ठेषु तैलयोगः सिद्धोऽयं संमतो भिषजाम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.106a",
  "kind": "metre",
  "line": "श्वेतकरवीरपल्लवमूलत्वग्वत्सको विडङ्गश्च।",
  "before": "इति श्वेतकरवीराद्यं तैलम्।",
  "after": "कुष्ठार्कमूलसर्षपशिग्रुत्वग्रोहिणी कटुका॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.107c",
  "kind": "metre",
  "line": "इति श्वेतकरवीरपल्लवाद्यं तैलम्।",
  "before": "दत्त्वा तैलचतुर्गुणमभ्यङ्गात् कुष्ठकण्डूघ्नम्॥",
  "after": "तिक्तालाबुकबीजं द्वे तुत्थे रोचना हरिद्रे द्वे।",
  "note": "14 aksharas"
 },
 {
  "id": "06.07.109a",
  "kind": "metre",
  "line": "कासीसहिङ्गुशिग्रुत्र्यूषणसुरदारुतुम्बुरुविडङ्गम्।",
  "before": "बृहतीफलमेरण्डः सविशालश्चित्रको मूर्वा॥",
  "after": "लाङ्गलकं कुटजत्वक् कटुकाख्या रोहिणी चैव॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.110b",
  "kind": "metre",
  "line": "कण्डूकुष्ठविनाशनमभ्यङ्गान्मारुतकफहन्तृ॥",
  "before": "सर्षपतैलं कल्कैरेतैर्मूत्रे चतुर्गुणे साध्यम्।",
  "after": "इति तिक्तेक्ष्वाक्वादितैलम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.111b",
  "kind": "metre",
  "line": "जातीप्रवालसर्षपलशुनविडङ्गं करञ्जत्वक्॥",
  "before": "कनकक्षीरी शैला भार्गी दन्त्याः फलानि मूलं च।",
  "after": "सप्तच्छदार्कपल्लवमूलत्वङ्निम्बचित्रकास्फोताः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.112a",
  "kind": "metre",
  "line": "सप्तच्छदार्कपल्लवमूलत्वङ्निम्बचित्रकास्फोताः।",
  "before": "जातीप्रवालसर्षपलशुनविडङ्गं करञ्जत्वक्॥",
  "after": "गुञ्जैरण्डं बृहतीमूलकसुरसार्जकफलानि॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.112b",
  "kind": "metre",
  "line": "गुञ्जैरण्डं बृहतीमूलकसुरसार्जकफलानि॥",
  "before": "सप्तच्छदार्कपल्लवमूलत्वङ्निम्बचित्रकास्फोताः।",
  "after": "कुष्ठं पाठा मुस्तं तुम्बुरुमूर्वावचाः सषड्ग्रन्थाः।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.113b",
  "kind": "metre",
  "line": "एडगजकुटजशिग्रुत्र्यूषणभल्लातकक्षवकाः॥",
  "before": "कुष्ठं पाठा मुस्तं तुम्बुरुमूर्वावचाः सषड्ग्रन्थाः।",
  "after": "अथ षड्ग्रन्था’ इति पा-.",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.114a",
  "kind": "metre",
  "line": "हरितालमवाक्पुष्पी तुत्थं कम्पिल्लकोऽमृतासंज्ञः।",
  "before": "अथ षड्ग्रन्था’ इति पा-.",
  "after": "सौराष्ट्री कासीसं दार्वीत्वक् सर्जिकालवणम्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.115a",
  "kind": "metre",
  "line": "कल्कैरेतैस्तैलं करवीरकमूलपल्लवकषाये।",
  "before": "सौराष्ट्री कासीसं दार्वीत्वक् सर्जिकालवणम्॥",
  "after": "सार्षपमथवा तैलं गोमूत्रचतुर्गुणं साध्यम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.116a",
  "kind": "metre",
  "line": "स्थाप्यं कटुकालाबुनि तत्सिद्धं तेन मण्डलान्याशु।",
  "before": "सार्षपमथवा तैलं गोमूत्रचतुर्गुणं साध्यम्॥",
  "after": "भिन्द्याद्भिषगभ्यङ्गात्कृमींश्च कण्डूं च विनिहन्यात्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.117a",
  "kind": "metre",
  "line": "कुष्ठं तमालपत्रं मरिचं समनःशिलं सकासीसम्।",
  "before": "इति कनकक्षीरीतैलम्।",
  "after": "तैलेन युक्तमुषितं सप्ताहं भाजने ताम्रे॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.118c",
  "kind": "metre",
  "line": "इति सिध्मे लेपः।",
  "before": "मासान्नवं किलासं स्नानं मुक्त्वा विशुद्धतनोः॥",
  "after": "सर्षपकरञ्जकोषातकीनां तैलान्यथेङ्गुदीनां च।",
  "note": "6 aksharas"
 },
 {
  "id": "06.07.119a",
  "kind": "metre",
  "line": "सर्षपकरञ्जकोषातकीनां तैलान्यथेङ्गुदीनां च।",
  "before": "इति सिध्मे लेपः।",
  "after": "कुष्ठेषु हितान्याहुस्तैलं यच्चापि खदिरसारस्य॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.119b",
  "kind": "metre",
  "line": "कुष्ठेषु हितान्याहुस्तैलं यच्चापि खदिरसारस्य॥",
  "before": "सर्षपकरञ्जकोषातकीनां तैलान्यथेङ्गुदीनां च।",
  "after": "जीवन्ती मञ्जिष्ठा दार्वी कम्पिल्लकः पयस्तुत्थम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.121a",
  "kind": "metre",
  "line": "देयः समधूच्छिष्टो विपादिका तेन शाम्यतेऽभ्यक्ता।",
  "before": "एष घृततैलपाकः सिद्धः सिद्धे च सर्जरसः॥",
  "after": "चर्मैककुष्ठकिटिमं कुष्ठं शाम्यत्यलसकं च॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.122a",
  "kind": "metre",
  "line": "किण्वं वराहरुधिरं पृथ्वीका सैन्धवं च लेपः स्यात्।",
  "before": "इति विपादिकाहरघृततैले।",
  "after": "लेपो योज्यः कुस्तुम्बुरूणि कुष्ठं च मण्डलनुत्॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.123a",
  "kind": "metre",
  "line": "पूतीकदारुजटिलाः पक्वसुरा क्षौद्रमुद्गपर्ण्यौ च।",
  "before": "लेपो योज्यः कुस्तुम्बुरूणि कुष्ठं च मण्डलनुत्॥",
  "after": "लेपः सकाकनासो मण्डलकुष्ठापहः सिद्धः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.124a",
  "kind": "metre",
  "line": "चित्रकशोभाञ्जनकौ गुडूच्यपामार्गदेवदारूणि।",
  "before": "लेपः सकाकनासो मण्डलकुष्ठापहः सिद्धः॥",
  "after": "खदिरो धवश्चलेपः श्यामा दन्ती द्रवन्ती च॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.125a",
  "kind": "metre",
  "line": "लाक्षारसाञ्जनैलाः पुनर्नवा चेति कुष्ठिनो लेपाः।",
  "before": "खदिरो धवश्चलेपः श्यामा दन्ती द्रवन्ती च॥",
  "after": "दधिमण्डयुताः सर्वे देयाः षण्मारुतकफकुष्ठघ्नाः॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.125b",
  "kind": "metre",
  "line": "दधिमण्डयुताः सर्वे देयाः षण्मारुतकफकुष्ठघ्नाः॥",
  "before": "लाक्षारसाञ्जनैलाः पुनर्नवा चेति कुष्ठिनो लेपाः।",
  "after": "एडगजकुष्ठसैन्धवसौवीरकसर्षपैः कृमिघ्नैश्च।",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.126a",
  "kind": "metre",
  "line": "एडगजकुष्ठसैन्धवसौवीरकसर्षपैः कृमिघ्नैश्च।",
  "before": "दधिमण्डयुताः सर्वे देयाः षण्मारुतकफकुष्ठघ्नाः॥",
  "after": "कृमिकुष्ठमण्डलाख्यं दद्रूकुष्ठं च शममुपैति॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.126b",
  "kind": "metre",
  "line": "कृमिकुष्ठमण्डलाख्यं दद्रूकुष्ठं च शममुपैति॥",
  "before": "एडगजकुष्ठसैन्धवसौवीरकसर्षपैः कृमिघ्नैश्च।",
  "after": "एडगजः सर्जरसो मूलकबीजं च सिध्मकुष्ठानाम्।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.127a",
  "kind": "metre",
  "line": "एडगजः सर्जरसो मूलकबीजं च सिध्मकुष्ठानाम्।",
  "before": "कृमिकुष्ठमण्डलाख्यं दद्रूकुष्ठं च शममुपैति॥",
  "after": "काञ्जिकयुक्तं तु पृथङ्मतमिदमुद्वर्तनं लेपाः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.127b",
  "kind": "metre",
  "line": "काञ्जिकयुक्तं तु पृथङ्मतमिदमुद्वर्तनं लेपाः॥",
  "before": "एडगजः सर्जरसो मूलकबीजं च सिध्मकुष्ठानाम्।",
  "after": "वासा त्रिफला पाने स्नाने चोद्वर्तने प्रलेपे च।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.130a",
  "kind": "metre",
  "line": "जलवाप्यलोहकेशरपत्रप्लवचन्दनं मृणालानि।",
  "before": "सप्तच्छदकरवीराः शस्यन्ते स्नानपानेषु॥",
  "after": "भागोत्तराणि सिद्धं प्रलेपनं पित्तकफकुष्ठे॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.131a",
  "kind": "metre",
  "line": "यष्ट्याह्वलोध्रपद्मकपटोलपिचुमर्दचन्दनरसाश्च।",
  "before": "भागोत्तराणि सिद्धं प्रलेपनं पित्तकफकुष्ठे॥",
  "after": "स्नाने पाने च हिताः सुशीतलाः पित्तकुष्ठिभ्यः॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.07.132a",
  "kind": "metre",
  "line": "आलेपनं प्रियङ्गुर्हरेणुका वत्सकस्य च फलानि।",
  "before": "स्नाने पाने च हिताः सुशीतलाः पित्तकुष्ठिभ्यः॥",
  "after": "सातिविषा च ससेव्या सचन्दना रोहिणी कटुका॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.132b",
  "kind": "metre",
  "line": "सातिविषा च ससेव्या सचन्दना रोहिणी कटुका॥",
  "before": "आलेपनं प्रियङ्गुर्हरेणुका वत्सकस्य च फलानि।",
  "after": "तिक्तघृतैर्धौतघृतैरभ्यङ्गो दह्यमानकुष्ठेषु।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.133a",
  "kind": "metre",
  "line": "तिक्तघृतैर्धौतघृतैरभ्यङ्गो दह्यमानकुष्ठेषु।",
  "before": "सातिविषा च ससेव्या सचन्दना रोहिणी कटुका॥",
  "after": "तैलैश्चन्दनमधुकप्रपौण्डरीकोत्पलयुतैश्च॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.133b",
  "kind": "metre",
  "line": "तैलैश्चन्दनमधुकप्रपौण्डरीकोत्पलयुतैश्च॥",
  "before": "तिक्तघृतैर्धौतघृतैरभ्यङ्गो दह्यमानकुष्ठेषु।",
  "after": "क्लेदे प्रपतति चाङ्गे दाहे विस्फोटके सचर्मदले।",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.134a",
  "kind": "metre",
  "line": "क्लेदे प्रपतति चाङ्गे दाहे विस्फोटके सचर्मदले।",
  "before": "तैलैश्चन्दनमधुकप्रपौण्डरीकोत्पलयुतैश्च॥",
  "after": "शीताः प्रदेहसेका व्यधो विरेको घृतं तिक्तम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.135a",
  "kind": "metre",
  "line": "खदिरघृतं निम्बघृतं दार्वीघृतमुत्तमं पटोलघृतम्।",
  "before": "शीताः प्रदेहसेका व्यधो विरेको घृतं तिक्तम्॥",
  "after": "कुष्ठेषु रक्तपित्तप्रबलेषु भिषग्जितं सिद्धम्॥",
  "note": "21 aksharas"
 },
 {
  "id": "06.07.136a",
  "kind": "metre",
  "line": "त्रिफलात्वचोऽर्धपलिकाः पटोलपत्रं च कार्षिकाः शेषाः।",
  "before": "कुष्ठेषु रक्तपित्तप्रबलेषु भिषग्जितं सिद्धम्॥",
  "after": "कटुरोहिणी सनिम्बा यष्ट्याह्वा त्रायमाणा च॥",
  "note": "20 aksharas"
 },
 {
  "id": "06.07.137a",
  "kind": "metre",
  "line": "एष कषायः साध्यो दत्त्वा द्विपलं मसूरविदलानाम्।",
  "before": "कटुरोहिणी सनिम्बा यष्ट्याह्वा त्रायमाणा च॥",
  "after": "सलिलाढकेऽष्टभगे शेषे पूतो रसो ग्राह्यः॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.138a",
  "kind": "metre",
  "line": "ते च कषायेऽष्टपले चतुष्पलं सर्पिषश्च पक्तव्यम्।",
  "before": "सलिलाढकेऽष्टभगे शेषे पूतो रसो ग्राह्यः॥",
  "after": "यावत्स्यादष्टपलं शेषं पेयं ततः कोष्णम्॥",
  "note": "19 aksharas"
 },
 {
  "id": "06.07.139a",
  "kind": "metre",
  "line": "तद्वातपित्तकुष्ठं वीसर्पं वातशोणितं प्रबलम्।",
  "before": "यावत्स्यादष्टपलं शेषं पेयं ततः कोष्णम्॥",
  "after": "ज्वरदाहगुल्मविद्रधिविभ्रमविस्फोटकान् हन्ति॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.139b",
  "kind": "metre",
  "line": "ज्वरदाहगुल्मविद्रधिविभ्रमविस्फोटकान् हन्ति॥",
  "before": "तद्वातपित्तकुष्ठं वीसर्पं वातशोणितं प्रबलम्।",
  "after": "निम्बपटोलं दार्वीं दुरालभां तिक्तरोहिणीं त्रिफलाम्।",
  "note": "18 aksharas"
 }
