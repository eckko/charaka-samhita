[
 {
  "id": "03.02.17a",
  "kind": "sample",
  "line": "नाभिस्तनान्तरं जन्तोरामाशय इति स्मृतः।",
  "before": "आचचक्षे ततस्तेभ्यो यत्राहारो विपच्यते॥",
  "after": "अशितं खादितं पीतं लीढं चात्र विपच्यते॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.03.18a",
  "kind": "sample",
  "line": "इत्येतद्भेषजं प्रोक्तमायुषः परिपालनम्।",
  "before": "धार्मिकैः सात्त्विकैर्नित्यं सहास्या वृद्धसंमतैः॥",
  "after": "येषामनियतो मृत्युस्तस्मिन् काले सुदारुणे॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.01.147b",
  "kind": "sample",
  "line": "स्मृत्वा स्वभावं भावानां स्मरन् दुःखात् प्रमुच्यते",
  "before": "स्मृतिः सत्सेवनाद्यैश्च धृत्यन्तैरुपजायते।",
  "after": "वक्ष्यन्ते कारणान्यष्टौ स्मृतिर्यैरुपजायते।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.3",
  "kind": "sample",
  "line": "‘पुरुषोऽयं लोकसंनितः’इत्युवाच भगवान् पुनर्वसुरात्रेयः।",
  "before": "इति ह स्माह भगवानात्रेयः॥",
  "after": "यावन्तो हि लोके (भूर्तिमन्तो ) भावविशेषास्तावन्तः पुरुषे, यावन्तः पुरुषे तावन्तो लोके; इत्येवंवादिनं भगवन्तमात्रेयमग्निवेश उवाच---नेतावता वाक्येनोक्तं वाक्यार्थमवगाहामहे, भगवता बुद्ध्या भूयस्तरमतोऽनुव्याख्यायमानं शुश्रूषामह इति॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.16a",
  "kind": "sample",
  "line": "शुद्धसत्त्वस्य या शुद्धा सत्या बुद्धिः प्रवर्तते।",
  "before": "शुद्धः स्थिरः प्रसन्नार्चिर्दीलो दीलाशये यथा॥",
  "after": "यया भिनत्त्यतिबलं महामोहमयं तमः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.40",
  "kind": "sample",
  "line": "ताश्चैनां यथोक्तगुणाः स्त्रियोऽनुशिष्युः---अनागतावीर्मा प्रवाहिष्ठाः; या ह्यनागतावीः प्रवाहते व्यर्थमेवास्यास्तत् कर्म भवति, प्रजा चास्या विकृता विकृतिमापन्ना च, श्वासकासशोषप्लीहप्रसक्ता वा भवति।",
  "before": "कार्तिकेयद्युतिं पुत्रं कार्तिकेयाभिरक्षितम्’ इति॥",
  "after": "यथा हि क्षवथूद्गारवातमूत्रपुरीषवेगान् प्रयतमानोऽप्यप्राप्तकालान्न लभते कृच्छ्रेण वाप्यवाप्नोति, तथानागतकालं गर्भमपि प्रवाहमाणा; यथा चैषामेव क्षवथ्वादीनां सन्धारणमुपघातायोपपद्यते, तथा प्राप्तकालस्य गर्भस्याप्रवाहणमिति।सा यथानिर्देशं कुरुष्वेति वक्तव्या स्यात्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.43",
  "kind": "sample",
  "line": "अथास्य ताल्वोष्ठकण्ठजिह्वाप्रमार्जनमारभेताङ्गुल्या सुपरिलिखितनखया सुप्रक्षालितोपधानकार्पास?सपिचुमत्या।",
  "before": "ततः प्रत्यागतप्राणं प्रकृतिभूतमभिसमीक्ष्य स्नानोदकग्रहणाभ्यामुपपादयेत्॥",
  "after": "प्रथमं प्रमार्जितास्यस्य चास्य शिरस्तालु कार्पासपिचुना स्नेहगर्भेण प्रतिसंछादयेत्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.01.26a",
  "kind": "sample",
  "line": "तत्र श्लोकः---",
  "before": "बलमांसविहीनस्य तत् सर्वं मरणोदयम्॥",
  "after": "इति वर्णस्वरावुक्तौ लक्षणार्थं मुमूर्षताम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.02.16b",
  "kind": "sample",
  "line": "इष्टो वा यदि वानिष्टो न स जीवति तां समाम्॥",
  "before": "वियोनिर्विदुरो गन्धो यस्य गात्रेषु जायते।",
  "after": "एतावद्गन्धविज्ञानं,रसज्ञानमतः परम्।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.07.8a",
  "kind": "sample",
  "line": "संस्थानमाकृतिर्ज्ञेया सुषमा विषमा च सा।",
  "before": "छाया विवर्तते यस्य स्वस्थोऽपि प्रेत एव सः॥",
  "after": "मध्यमल्पं महच्चोक्तं प्रमाणं त्रिविधं नृणाम्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.11.15a",
  "kind": "sample",
  "line": "ग्रीवावमर्दो बलवाञ्जिह्वाश्वयथुरेव च।",
  "before": "उत्पद्याशु विनश्यन्ति न चिरात् स विनश्यति॥",
  "after": "ब्रध्नास्यगलपाकश्च यस्य पक्वं तमादिशेत्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.05.2",
  "kind": "sample",
  "line": "इति ह स्माह भगवानात्रेयः॥",
  "before": "अथातो वत्सककल्पं व्याख्यास्यामः॥",
  "after": "अथ वत्सकनामानि भेदं स्त्रीपुंसयोस्तथा।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.06.13c",
  "kind": "sample",
  "line": "दश पिच्छा घृतं चैकं षट् च वर्तिक्रियाः शुभाः॥",
  "before": "क्षीरे द्वौ द्वौ सुरा चैका क्वाथा द्वाविंशतिस्तथा।",
  "after": "लेहेऽष्टौ सप्त मांसे च योग इक्षुरसेऽपरः।",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.07.49a",
  "kind": "sample",
  "line": "तापे पाण्ड्वामयेऽल्पेऽग्नौ शस्ता निर्यन्त्रणाशिनः।",
  "before": "मूत्रकृच्छ्रे ज्वरे वम्यां कासे श्वासे भ्रमे क्षये॥",
  "after": "योगः सर्वविषाणां च मतः श्रेष्ठो विरेचने॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.08.16b",
  "kind": "sample",
  "line": "लवणं वा भवेत्तेन युक्तं दद्याद्विरेचनम्॥",
  "before": "यस्य यत् पानमन्नं च हृद्यं स्वाद्वथ वा कटु।",
  "after": "तत्र श्लोकाः---",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.11.13a",
  "kind": "sample",
  "line": "क्षीरेणालोड्य संपक्वं पिबेत्तच्च विरेचनम्।",
  "before": "कल्कभागे तयोरेव त्रिवृच्छ्यामार्धसंयुते॥",
  "after": "दन्तीद्रवन्त्योः कल्पोऽयमजशृङ्ग्यजगन्धयोः॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.12.72a",
  "kind": "sample",
  "line": "भेषजं दोषरुद्धं चेन्नोर्ध्वं नाधः प्रवर्तते।",
  "before": "तेनाध्मानं तृषा च्छर्दिर्विबन्धश्चैव शाम्यति॥",
  "after": "सोद्गारं साङ्गशूलं च स्वेदं तत्रावचारयेत्॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "07.12.79a",
  "kind": "sample",
  "line": "रूक्ष-बह्वनिल-क्रूरकोष्ठ-व्यायामशालिनाम्।",
  "before": "तेनास्य स्नेहजः श्लेष्मा सङ्गश्चैवोपशाम्यति॥",
  "after": "दीप्ताग्नीनां च भैषज्यमविरिच्यैव जीर्यति॥",
  "note": "ordinary line, no flag"
 }
]